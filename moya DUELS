-- Anti Void: only while any Anti Bat is ON. If heading to void -> reset character (no air freeze).
if not _G._MOYA_AntiVoidConn then
    _G._MOYA_AntiVoidConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            if not (antiBatActive or antiBatV2Active or antiBatV3Active or antiBatV4Active or antiBatV5Active or antiBatV6Active or antiBatV7Active or antiBatV8Active) then
                return
            end
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then return end
            local pos = hrp.Position
            local y = pos.Y
            local vy = hrp.AssemblyLinearVelocity.Y
            -- track last safe grounded position only
            if y > 2 and vy > -30 then
                local ray = RaycastParams.new()
                ray.FilterType = Enum.RaycastFilterType.Exclude
                ray.FilterDescendantsInstances = {char}
                local under = workspace:Raycast(pos + Vector3.new(0, 1.5, 0), Vector3.new(0, -8, 0), ray)
                if under then
                    _G._MOYA_LastSafePos = Vector3.new(pos.X, under.Position.Y + (hum.HipHeight or 2) + 1.2, pos.Z)
                    _G._MOYA_LastSafeT = tick()
                end
            end
            -- void danger: deep fall OR no floor under while very low
            local inVoid = y < -15
            if not inVoid and y < 5 and vy < -80 then
                local ray = RaycastParams.new()
                ray.FilterType = Enum.RaycastFilterType.Exclude
                ray.FilterDescendantsInstances = {char}
                local under = workspace:Raycast(pos, Vector3.new(0, -250, 0), ray)
                if not under then inVoid = true end
            end
            if not inVoid then return end
            -- cooldown so we don't spam reset
            if (_G._MOYA_VoidResetT or 0) + 1.2 > tick() then return end
            _G._MOYA_VoidResetT = tick()
            local safe = _G._MOYA_LastSafePos
            if safe and (_G._MOYA_LastSafeT or 0) + 20 > tick() then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.Velocity = Vector3.zero
                hrp.CFrame = CFrame.new(safe)
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            else
                -- hard reset character (respawn) — no floating in air
                pcall(function()
                    _G.MOYA_ALLOW_RESET = true
                    LP:LoadCharacter()
                    task.delay(0.5, function() _G.MOYA_ALLOW_RESET = false end)
                end)
            end
        end)
    end)
end

