local function joxStartAutoPath(side)
    local S = _G.JoxAutoPathState
    local P = _G.JoxAutoPathPoints
    local isLeft = side == "left"
    local connKey = isLeft and "leftConn" or "rightConn"
    joxStopAutoPath(side)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not root or hum.Health <= 0 then
        joxFinishAutoPath(side)
        return
    end
    local phaseKey = isLeft and "leftPhase" or "rightPhase"
    S[phaseKey] = 1
    local startChar = char
    S[connKey] = RunService.Heartbeat:Connect(function()
        if (isLeft and not autoLeftEnabled) or ((not isLeft) and not autoRightEnabled) then
            joxStopAutoPath(side)
            return
        end
        local currentChar = LP.Character
        local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
        if currentChar ~= startChar or not currentRoot or not currentHum or currentHum.Health <= 0 then
            joxFinishAutoPath(side)
            return
        end
        local state = currentHum:GetState()
        if currentHum.PlatformStand or state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll then
            joxFinishAutoPath(side)
            return
        end
        local phase = S[phaseKey]
        local firstKey = isLeft and "L1" or "R1"
        local secondKey = isLeft and "L2" or "R2"
        local faceKey = isLeft and "LFace" or "RFace"
        local target = phase == 1 and P[firstKey] or P[secondKey]
        local delta = Vector3.new(target.X - currentRoot.Position.X, 0, target.Z - currentRoot.Position.Z)
        -- Auto Left/Right use fixed map waypoints. Allow normal spawn-to-waypoint
        -- distances; the old 120-stud cutoff made the toggle instantly disable.
        if delta.Magnitude > 1500 then
            joxFinishAutoPath(side)
            return
        end
        if delta.Magnitude < 1 then
            if phase == 1 then
                S[phaseKey] = 2
                if _G.JoxPathfind then _G.JoxPathfind.reset(firstKey) end
                return
            end
            currentHum:Move(Vector3.zero, false)
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            local face = P[faceKey]
            if face then
                pcall(function()
                    currentRoot.CFrame = CFrame.new(currentRoot.Position, Vector3.new(face.X, currentRoot.Position.Y, face.Z))
                end)
            end
            joxFinishAutoPath(side)
            return
        end
        local moveDir = delta.Unit
        if _G.JoxPathfind then
            local pathDir = _G.JoxPathfind.dirTo(firstKey == "L1" and (phase == 1 and "L1" or "L2") or (phase == 1 and "R1" or "R2"), currentRoot.Position, target)
            if pathDir then moveDir = pathDir end
        end
        currentHum:Move(moveDir, false)
        local speed = _G.JoxAutoPathSpeed(phase)
        currentRoot.AssemblyLinearVelocity = Vector3.new(moveDir.X * speed, currentRoot.AssemblyLinearVelocity.Y, moveDir.Z * speed)
    end)
end

