-- Aim Carve: premium-style aimbot path assist (no meta, light)
-- Curves chase into target's back-shoulder, holds contact ring, soft height match.
_G.aimCarveEnabled = false
_G.AimCarve = _G.AimCarve or {enabled=false, conn=nil, side=1, t=0}

function _G.AimCarve.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.aimCarveEnabled = true
    _G.AimCarve.enabled = true
    if _G.AimCarve.conn then pcall(function() _G.AimCarve.conn:Disconnect() end); _G.AimCarve.conn=nil end
    _G.AimCarve.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.AimCarve.enabled then return end
        -- only while bat aimbot is actually running
        if not (joxBatAimbotEnabled or aimbotV2Enabled) then return end
        pcall(function()
            local char = player and player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end

            local my = root.Position
            local best, bd, btr = nil, 42, nil
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                    local th = plr.Character:FindFirstChildOfClass("Humanoid")
                    if tr and th and th.Health > 0 then
                        local d = (tr.Position - my).Magnitude
                        if d < bd then bd, best, btr = d, plr, tr end
                    end
                end
            end
            if not btr then return end

            local tpos = btr.Position
            local tvel = btr.AssemblyLinearVelocity or Vector3.zero
            -- predict a bit
            local pred = tpos + Vector3.new(tvel.X, 0, tvel.Z) * 0.1
            -- approach from back-shoulder (anti-bat front block)
            local look = btr.CFrame.LookVector
            local back = Vector3.new(-look.X, 0, -look.Z)
            if back.Magnitude < 0.1 then
                back = Vector3.new(my.X - pred.X, 0, my.Z - pred.Z)
            end
            back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0, 0, 1)
            local side = Vector3.new(-back.Z, 0, back.X) * (_G.AimCarve.side or 1)
            -- flip shoulder if target strafes hard
            local tvf = Vector3.new(tvel.X, 0, tvel.Z)
            if tvf.Magnitude > 12 and side:Dot(tvf.Unit) < -0.2 then
                _G.AimCarve.side = -(_G.AimCarve.side or 1)
                side = -side
            end
            local goal = pred + back * 2.9 + side * 1.35
            local flat = Vector3.new(goal.X - my.X, 0, goal.Z - my.Z)
            if flat.Magnitude < 0.05 then return end
            local dir = flat.Unit
            local v = root.AssemblyLinearVelocity
            local spd = math.clamp(bd * 2.2, 22, 58)
            if bd < 6 then spd = math.min(spd, 30) end -- contact ring: don't overshoot
            -- light blend so we assist aimbot, not fight it
            root.AssemblyLinearVelocity = Vector3.new(
                v.X + (dir.X * spd - v.X) * 0.2,
                v.Y + ((pred.Y - my.Y) * 10 - v.Y) * 0.12,
                v.Z + (dir.Z * spd - v.Z) * 0.2
            )
            -- soft face
            if bd < 14 then
                local face = CFrame.lookAt(my, Vector3.new(pred.X, my.Y, pred.Z))
                root.CFrame = root.CFrame:Lerp(CFrame.new(my) * (face - face.Position), 0.16)
            end
        end)
    end)
end

function _G.AimCarve.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.aimCarveEnabled = false
    _G.AimCarve.enabled = false
    if _G.AimCarve.conn then pcall(function() _G.AimCarve.conn:Disconnect() end); _G.AimCarve.conn=nil end
end


