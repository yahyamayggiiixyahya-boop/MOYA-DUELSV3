local joxMusicSound, joxMusicActive = nil, nil
local joxMusicRows = {}
local function joxStopMusic()
    joxMusicActive = nil
    if joxMusicSound then
        pcall(function() joxMusicSound:Stop(); joxMusicSound:Destroy() end)
        joxMusicSound = nil
    end
    for _,setRow in pairs(joxMusicRows) do pcall(setRow,false) end
end
local function joxLooksLikeAudio(data)
    if type(data) ~= "string" or #data < 1024 then return false end
    local head = string.lower(string.sub(data, 1, 4096))
    -- Reject common web pages / API errors, including responses that are saved as .mp3.
    if string.find(head, "<html", 1, true) or string.find(head, "<!doctype", 1, true)
        or string.find(head, "<head", 1, true) or string.find(head, "access denied", 1, true)
        or string.find(head, "not found", 1, true) or string.find(head, "rate limit", 1, true)
        or string.find(head, "{\"error", 1, true) then
        return false
    end
    -- Accept common audio container/signature headers, not only MP3 files with ID3 at byte 1.
    local b1, b2, b3, b4 = string.byte(data, 1, 4)
    if b1 == 73 and b2 == 68 and b3 == 51 then return true end -- ID3/MP3
    if b1 == 255 and b2 and b2 >= 224 then return true end -- MPEG frame sync
    if b1 == 82 and b2 == 73 and b3 == 70 and b4 == 70 then return true end -- RIFF/WAV
    if b1 == 79 and b2 == 103 and b3 == 103 and b4 == 83 then return true end -- Ogg
    if b1 == 102 and b2 == 76 and b3 == 97 and b4 == 67 then return true end -- FLAC
    if b1 == 102 and b2 == 116 and b3 == 121 and b4 == 112 then return true end -- MP4/M4A ftyp
    -- Some MP3s have leading metadata; search a short prefix for an MPEG frame sync.
    for i = 1, math.min(#data - 1, 4096) do
        local a, b = string.byte(data, i, i + 1)
        if a == 255 and b and b >= 224 then return true end
    end
    return false
end
local function joxDownload(url)
    local requestFn = request or http_request or (syn and syn.request)
    if type(requestFn) == "function" then
        local ok, result = pcall(function() return requestFn({Url=url, Method="GET"}) end)
        if ok and type(result) == "table" and type(result.Body) == "string" then
            local status = tonumber(result.StatusCode or result.Status or 200) or 200
            if status >= 200 and status < 300 then return result.Body end
            error("HTTP status " .. tostring(status))
        end
    end
    return game:HttpGet(url)
end
local function joxPlayMusic(index)
    if joxMusicActive == index then joxStopMusic(); return end
    joxStopMusic()
    local track = JOX_MUSIC_TRACKS[index]
    if not track then return end
    joxMusicActive = index
    if joxMusicRows[index] then pcall(joxMusicRows[index],true) end
    task.spawn(function()
        local assetFn = getsynasset or getcustomasset
        if type(assetFn) ~= "function" or type(writefile) ~= "function"
            or type(readfile) ~= "function" or type(isfile) ~= "function" then
            warn("[JOX Playlist] Delta/executor must support getcustomasset, writefile and isfile.")
            if joxMusicActive == index then joxStopMusic() end
            return
        end
        local ok, err = pcall(function()
            if type(isfolder) == "function" and not isfolder(JOX_MUSIC_FOLDER) then
                makefolder(JOX_MUSIC_FOLDER)
            end
            local path = JOX_MUSIC_FOLDER .. "/" .. track.file
            local cached = nil
            if isfile(path) then
                local readOk, contents = pcall(readfile, path)
                if readOk and joxLooksLikeAudio(contents) then
                    cached = contents
                elseif type(delfile) == "function" then
                    pcall(delfile, path) -- remove a broken/stale cache and retry
                end
            end
            if not cached then
                local response = joxDownload(track.url)
                if not joxLooksLikeAudio(response) then
                    error("URL did not return a recognizable audio file; the link may be expired, blocked, or serving a web page")
                end
                writefile(path, response)
            end
            if joxMusicActive ~= index then return end
            local assetId = assetFn(path)
            local snd = Instance.new("Sound")
            snd.Name = "JOX6_Playlist"
            snd.SoundId = assetId
            snd.Volume = 1.6
            snd.Looped = true
            snd.Parent = game:GetService("SoundService")
            joxMusicSound = snd
            snd:Play()
            -- Mobile executors can take longer to register a downloaded custom asset.
            local waited = 0
            while joxMusicActive == index and joxMusicSound == snd
                and not snd.IsLoaded and waited < 15 do
                task.wait(0.5)
                waited = waited + 0.5
            end
            if joxMusicActive == index and joxMusicSound == snd then
                if not snd.IsLoaded or snd.TimeLength <= 0 then
                    error("Audio file downloaded, but Roblox did not load it after 15 seconds. The source may be invalid or this audio format may not be supported.")
                end
            end
        end)
        if not ok then
            warn("[JOX Playlist] " .. track.name .. " failed: " .. tostring(err))
            if joxMusicActive == index then joxStopMusic() end
        end
    end)
end
