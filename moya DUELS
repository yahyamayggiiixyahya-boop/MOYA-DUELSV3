}

-- (JOX75) Shared Bypass-aimbot core: flat-distance sticky targeting, position-based
-- velocity, teleport (TP down / TP to base) snap, ground-wait vs hold-jump flyers.
NanzV3.AX = {vel=Vector3.zero, snapUntil=0, root=nil, pos=nil, t=0, ground=nil, groundT=0,
             HIGH=11, stickyPlr=nil, stickyUntil=0}
function NanzV3.AX.groundY(tRoot)
    local ax, now = NanzV3.AX, tick()
    if ax.ground and now - ax.groundT < 0.12 then return ax.ground end
    local gy = nil
    pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then list[#list+1] = p.Character end end
        params.FilterDescendantsInstances = list
        local res = workspace:Raycast(tRoot.Position, Vector3.new(0, -400, 0), params)
        if res then gy = res.Position.Y end
    end)
    ax.ground, ax.groundT = gy, now
    return gy
end
function NanzV3.AX.track(tRoot, now)
    local ax, pos = NanzV3.AX, tRoot.Position
    local teleported = false
    if ax.root ~= tRoot then
        ax.root, ax.pos, ax.t, ax.vel, ax.snapUntil, ax.ground = tRoot, pos, now, Vector3.zero, 0, nil
    else
        local dt = math.max(now - ax.t, 1/240)
        local disp = pos - ax.pos
        local flatD = Vector3.new(disp.X, 0, disp.Z)
        -- JOX76: real TP only (big vertical drop or very far jump), never lag/stall
        local isTP = (math.abs(disp.Y) > 12 and flatD.Magnitude < 15) or flatD.Magnitude > 70
        if isTP and now - (ax.lastSnap or 0) > 1.5 then
            teleported = true
            ax.lastSnap = now
            ax.vel = Vector3.zero
        else
            local v = flatD / dt
            if dt > 0.12 then v = Vector3.zero end
            if v.Magnitude > 80 then v = v.Unit * 80 end
            ax.vel = ax.vel:Lerp(v, 0.45)
        end
        ax.pos, ax.t = pos, now
    end
    return teleported
end
function NanzV3.AX.pick(myRoot)
    local ax, now = NanzV3.AX, tick()
    local function info(plr)
        local ch = plr and plr.Character
        local r = ch and ch:FindFirstChild("HumanoidRootPart")
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local dv = r.Position - myRoot.Position
            return r, math.sqrt(dv.X*dv.X + dv.Z*dv.Z), math.abs(dv.Y)
        end
    end
    if ax.stickyPlr and now < ax.stickyUntil then
        local r, flat = info(ax.stickyPlr)
        if r and flat <= 130 then return ax.stickyPlr end
    end
    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local r, flat, dy = info(plr)
            if r then
                local score = flat + dy * 0.2
                if score < bestScore then best, bestScore = plr, score end
            end
        end
    end
    ax.stickyPlr, ax.stickyUntil = best, now + 1.2
    return best
end
function NanzV3.AX.snap(root, tRoot)
    local tp, mp = tRoot.Position, root.Position
    local back = Vector3.new(mp.X - tp.X, 0, mp.Z - tp.Z)
    if back.Magnitude < 0.5 then
        local lv = tRoot.CFrame.LookVector
        back = Vector3.new(-lv.X, 0, -lv.Z)
    end
    back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
    local stand = tp + back * 3.5
    local tv = NanzV3.AX.vel
    pcall(function()
        root.CFrame = root.CFrame:Lerp(CFrame.new(stand, Vector3.new(tp.X, stand.Y, tp.Z)), 0.28)
        root.AssemblyLinearVelocity = Vector3.new(tv.X, 0, tv.Z)
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end
function NanzV3.AX.chase(root, tRoot, leadPos, speed, minDist)
    local ax = NanzV3.AX
    local myPos = root.Position
    local d = leadPos - myPos
    local flat = Vector3.new(d.X, 0, d.Z)
    local fm = flat.Magnitude
    local tv = ax.vel
    local gY = ax.groundY(tRoot)
    local targetY = tRoot.Position.Y
    local targetAboveGround = gY ~= nil and (targetY - gY) > (ax.HIGH or 4)
    local dyToTarget = targetY - myPos.Y

    -- Built-in aimbot fix: if target is above, go up and hit; if below/same, normal chase
    local waiting = aimbotHeightLockEnabled and targetAboveGround and dyToTarget > 6 and fm > 8
    local desiredY
    if dyToTarget > 1.5 then
        desiredY = targetY -- climb/jump to airborne or elevated target
    elseif waiting then
        desiredY = (gY or myPos.Y) + 3
    else
        desiredY = targetY
    end
    local dy = desiredY - myPos.Y

    if fm < (minDist or 1) and math.abs(dy) < 2.5 then
        root.AssemblyLinearVelocity = Vector3.new(tv.X, root.AssemblyLinearVelocity.Y * 0.5, tv.Z)
        local batT = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        if batT and autoSwingEnabled ~= false then pcall(batT.Activate, batT) end
        return
    end
    local spd = speed
    if fm > 15 then spd = math.min(spd * 1.25, 75) end
    spd = math.min(spd, tv.Magnitude + fm * 14)
    local fdir = fm > 0.01 and flat.Unit or Vector3.zero
    local vy
    if dy > 1.5 then
        vy = math.clamp(math.max(dy * 24, 48), 35, 105)
        pcall(function()
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Jump = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end)
    elseif dy < -2.5 then
        vy = math.clamp(dy * 18, -90, -6)
    else
        vy = math.clamp(dy * 16, -45, 45)
    end
    root.AssemblyLinearVelocity = Vector3.new(fdir.X * spd, vy, fdir.Z * spd)
end
