-- 3) Mass Balance: damp self oscillation (pos feedback loop) to reduce server reconcile snaps
_G.massBalanceEnabled = false
_G.MassBalance = _G.MassBalance or {enabled=false, conn=nil, prev=nil, prevV=nil}
function _G.MassBalance.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.massBalanceEnabled = true
    _G.MassBalance.enabled = true
    _G.MassBalance.prev, _G.MassBalance.prevV = nil, nil
    if _G.MassBalance.conn then pcall(function() _G.MassBalance.conn:Disconnect() end) end
    local sig = RunService.PreSimulation or RunService.Stepped
    _G.MassBalance.conn = sig:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.MassBalance.enabled then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local pos = root.Position
        local v = root.AssemblyLinearVelocity
        local prev = _G.MassBalance.prev
        local prevV = _G.MassBalance.prevV
        _G.MassBalance.prev, _G.MassBalance.prevV = pos, v
        if not prev or not prevV then return end
        local dv = v - prevV
        -- oscillation = velocity flipping sign on same axis hard
        local ox = (prevV.X * v.X < -25) and math.abs(dv.X) > 40
        local oz = (prevV.Z * v.Z < -25) and math.abs(dv.Z) > 40
        if ox or oz then
            root.AssemblyLinearVelocity = prevV:Lerp(v, 0.25)
        end
        if root.AssemblyAngularVelocity.Magnitude > 25 then
            root.AssemblyAngularVelocity = root.AssemblyAngularVelocity * 0.4
        end
    end)
end
