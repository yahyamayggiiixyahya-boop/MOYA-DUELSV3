-- JOX Anti Bat: integrated version adapted from the supplied Anti Bat logic.
-- Uses separate non-yielding frame callbacks to prevent overlapping velocity spikes.
local joxAntiBatEnabled = false
local joxAntiBatState = {
    conn = nil,
    restoreConn = nil,
    amp = 10000,
    phase = 0,
    dir = 1,
    pendingRestore = false,
    savedXZ = nil,
    savedRoot = nil,
}
_G.JOXAntiBatEnabled = false
_G._JOXAntiBatDesiredXZ = nil
_G._JOXAntiBatSpiking = false

local function _joxAntiBatRestore()
    local st = joxAntiBatState
    if not st.pendingRestore then return end

    local root = st.savedRoot
    if root and root.Parent then
        local currentY = root.Velocity.Y
        local desired = _G._JOXAntiBatDesiredXZ
        local saved = st.savedXZ
        if desired then
            root.Velocity = Vector3.new(desired.X, currentY, desired.Z)
        elseif saved then
            root.Velocity = Vector3.new(saved.X, currentY, saved.Z)
        end
    end

    st.pendingRestore = false
    st.savedXZ = nil
    st.savedRoot = nil
    _G._JOXAntiBatSpiking = false
end

local function stopJoxAntiBat()
    local st = joxAntiBatState
    _G.JOXAntiBatEnabled = false
    joxAntiBatEnabled = false

    -- Restore any outstanding pulse before disconnecting the callbacks.
    pcall(_joxAntiBatRestore)
    if st.conn then pcall(function() st.conn:Disconnect() end); st.conn = nil end
    if st.restoreConn then pcall(function() st.restoreConn:Disconnect() end); st.restoreConn = nil end

    st.amp, st.phase, st.dir = 10000, 0, 1
    st.pendingRestore = false
    st.savedXZ, st.savedRoot = nil, nil
    _G._JOXAntiBatDesiredXZ = nil
    _G._JOXAntiBatSpiking = false
end

local function startJoxAntiBat()
    local st = joxAntiBatState
    if st.conn then pcall(function() st.conn:Disconnect() end); st.conn = nil end
    if st.restoreConn then pcall(function() st.restoreConn:Disconnect() end); st.restoreConn = nil end
    pcall(_joxAntiBatRestore)

    st.amp, st.phase, st.dir = 10000, 0, 1
    st.pendingRestore = false
    st.savedXZ, st.savedRoot = nil, nil
    joxAntiBatEnabled = true
    _G.JOXAntiBatEnabled = true

    -- Restore in RenderStepped; never yield inside Heartbeat.
    st.restoreConn = RunService.RenderStepped:Connect(function()
        if st.pendingRestore then _joxAntiBatRestore() end
    end)

    st.conn = RunService.Heartbeat:Connect(function()
        if not _G.JOXAntiBatEnabled or st.pendingRestore then return end
        local character = LP.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not root.Parent then return end

        st.savedXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
        st.savedRoot = root
        st.amp = st.amp + 500 * st.dir
        if st.amp >= 20000 then
            st.amp = 20000
            st.dir = -1
        elseif st.amp <= 10000 then
            st.amp = 10000
            st.dir = 1
        end

        st.phase = st.phase + math.random() * 0.5
        local magnitude = st.amp + math.random(-5000, 5000)
        local spikeX = math.cos(st.phase) * magnitude
        local spikeZ = math.sin(st.phase) * magnitude
        st.pendingRestore = true
        _G._JOXAntiBatSpiking = true
        root.Velocity = Vector3.new(spikeX, root.Velocity.Y, spikeZ)
    end)
end

_G.JOXAntiBat = {
    setEnabled = function(on) if on then startJoxAntiBat() else stopJoxAntiBat() end end,
    isEnabled = function() return _G.JOXAntiBatEnabled == true end,
    toggle = function() if _G.JOXAntiBatEnabled then stopJoxAntiBat() else startJoxAntiBat() end end,
}

