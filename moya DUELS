    LPH_ATTRIBUTES(VM(NONE))
    _G.tpInterceptEnabled = false
    _G.TPIntercept.enabled = false
    if _G.TPIntercept.conn then pcall(function() _G.TPIntercept.conn:Disconnect() end); _G.TPIntercept.conn=nil end
end

