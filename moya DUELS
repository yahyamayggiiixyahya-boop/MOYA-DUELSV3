-- Strike Pack: multi-tool combat helper (face, bat keep, soft chase, air hop, unragdoll)
-- Works alone or with aimbot. Soft forces only.
_G.strikePackEnabled = false
_G.StrikePack = _G.StrikePack or {enabled=false, conn=nil, swingCd=false, lastT=nil}

local function _spBat(char)
    if not char then return nil end
    local t = char:FindFirstChildOfClass("Tool")
    if t then return t end
    local bp = LP:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, x in ipairs(bp:GetChildren()) do
        if x:IsA("Tool") then
            local n = x.Name:lower()
            if n:find("bat") or n:find("slap") then return x end
        end
    end
    return nil
end

local function _spTarget(root)
    local best, bd = nil, 22
    local my = root.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            local th = plr.Character:FindFirstChildOfClass("Humanoid")
            if tr and th and th.Health > 0 then
                local d = (tr.Position - my).Magnitude
                if d < bd then bd, best = d, tr end
            end
        end
    end
    return best, bd
end

function _G.StrikePack.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.StrikePack.enabled = true
    _G.strikePackEnabled = true
    if _G.StrikePack.conn then pcall(function() _G.StrikePack.conn:Disconnect() end); _G.StrikePack.conn=nil end
    _G.StrikePack.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.StrikePack.enabled then return end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then return end

        -- 1) stay playable: no platform stand / sit stuck
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end

        -- 2) keep bat ready
        local bat = char:FindFirstChildOfClass("Tool")
        if not bat then
            bat = _spBat(char)
            if bat then pcall(function() hum:EquipTool(bat) end) end
        end

        local target, dist = _spTarget(root)
        if not target then return end
        _G.StrikePack.lastT = target
        local myPos = root.Position
        local tPos = target.Position
        local flat = Vector3.new(tPos.X - myPos.X, 0, tPos.Z - myPos.Z)
        local fm = flat.Magnitude
        local dy = tPos.Y - myPos.Y

        -- 3) soft face toward target (always light)
        if fm > 0.25 then
            local face = CFrame.lookAt(myPos, Vector3.new(tPos.X, myPos.Y, tPos.Z))
            local _, y, _ = face:ToEulerAnglesYXZ()
            local goal = CFrame.new(myPos) * CFrame.Angles(0, y, 0)
            pcall(function()
                root.CFrame = root.CFrame:Lerp(goal, 0.18)
            end)
        end

        -- 4) if aimbot off: gentle pull into bat range only
        local aimOn = (joxBatAimbotEnabled == true) or (aimbotV2Enabled == true)
        if not aimOn and dist > 4.5 and dist < 18 and fm > 0.2 then
            local dir = flat.Unit
            local v = root.AssemblyLinearVelocity
            local boost = math.clamp((dist - 4) * 4, 8, 28)
            root.AssemblyLinearVelocity = Vector3.new(
                v.X * 0.75 + dir.X * boost * 0.25,
                v.Y,
                v.Z * 0.75 + dir.Z * boost * 0.25
            )
        end

        -- 5) small hop help if target clearly above and close
        if dy > 3 and dist < 16 then
            local v = root.AssemblyLinearVelocity
            if v.Y < 20 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 32), v.Z)
                pcall(function() hum.Jump = true end)
            end
        end

        -- 6) dive a bit if target dropped under you
        if dy < -3 and dist < 14 then
            local v = root.AssemblyLinearVelocity
            if v.Y > -15 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, math.min(v.Y, -22), v.Z)
            end
        end

        -- 7) timed swing when in pocket
        if bat and bat.Parent == char and dist <= 7.5 and not _G.StrikePack.swingCd and autoSwingEnabled ~= false then
            local look = root.CFrame.LookVector
            local toT = fm > 0.01 and flat.Unit or Vector3.zero
            if toT.Magnitude > 0 and look:Dot(Vector3.new(toT.X, 0, toT.Z)) > 0.25 then
                _G.StrikePack.swingCd = true
                pcall(function() bat:Activate() end)
                task.delay(0.12, function() _G.StrikePack.swingCd = false end)
            end
        end
    end)
end

function _G.StrikePack.stop()
    LPH_ATTRIBUTES(VM(NONE))
