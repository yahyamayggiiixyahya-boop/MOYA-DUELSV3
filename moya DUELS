}

function _G.MoyaAntiBackLagV3Start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.antiBackLagV3Enabled = true
    _G.MoyaAntiBackLagV3.enabled = true
    pcall(_G.MoyaAntiBackLagStart)
    if _G.MoyaAntiBackLagV3.conn then
        pcall(function() _G.MoyaAntiBackLagV3.conn:Disconnect() end)
        _G.MoyaAntiBackLagV3.conn = nil
    end
    if _G.MoyaAntiBackLagV3.conn2 then
        pcall(function() _G.MoyaAntiBackLagV3.conn2:Disconnect() end)
        _G.MoyaAntiBackLagV3.conn2 = nil
    end
    _G.MoyaAntiBackLagV3.lastGood = nil
    _G.MoyaAntiBackLagV3.snapStreak = 0

    local function step()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.MoyaAntiBackLagV3.enabled then return end
        pcall(function()
            local char = player and player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end

            pcall(function()
                if root.SetNetworkOwner then root:SetNetworkOwner(player) end
            end)

            local v = root.AssemblyLinearVelocity
            local md = hum.MoveDirection
            local flatV = Vector3.new(v.X, 0, v.Z)
            local aimOn = (joxBatAimbotEnabled == true) or (aimbotV2Enabled == true)

            -- intent: MoveDirection, else chase velocity, else last want
            local want = nil
            if md.Magnitude > 0.05 then
                want = md.Unit
            elseif aimOn and flatV.Magnitude > 3 then
                want = flatV.Unit
            elseif flatV.Magnitude > 5 then
                want = flatV.Unit
            end
            if want then
                _G.MoyaAntiBackLagV3.want = want
                _G.MoyaAntiBackLagV3.lastWantT = tick()
            elseif tick() - (_G.MoyaAntiBackLagV3.lastWantT or 0) < 0.35 then
                want = _G.MoyaAntiBackLagV3.want
            end

            local pos = root.Position
            local prev = _G.MoyaAntiBackLagV3.lastGood
            if prev and want then
                local delta = pos - prev
                local flatD = Vector3.new(delta.X, 0, delta.Z)
                local back = flatD.Magnitude > 0.08 and flatD.Unit:Dot(want) < -0.2
                local bigSnap = flatD.Magnitude > 1.2 and flatD.Unit:Dot(want) < 0
                if back or bigSnap then
                    _G.MoyaAntiBackLagV3.snapStreak = (_G.MoyaAntiBackLagV3.snapStreak or 0) + 1
                    local n = math.min(_G.MoyaAntiBackLagV3.snapStreak, 6)
                    -- restore toward last good + small forward (stronger each streak)
                    local hold = Vector3.new(
                        prev.X + want.X * (0.2 + n * 0.12),
                        pos.Y,
                        prev.Z + want.Z * (0.2 + n * 0.12)
                    )
                    root.CFrame = CFrame.new(hold) * (root.CFrame - root.CFrame.Position)
                    local spd = math.clamp(math.max(flatV.Magnitude, 20 + n * 4), 20, 56)
                    root.AssemblyLinearVelocity = Vector3.new(want.X * spd, v.Y, want.Z * spd)
                    if root.AssemblyAngularVelocity.Magnitude > 10 then
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                    return
                else
                    _G.MoyaAntiBackLagV3.snapStreak = math.max(0, (_G.MoyaAntiBackLagV3.snapStreak or 0) - 1)
                end
            end

            -- kill reverse velocity component even without position snap
            if want and flatV.Magnitude > 8 then
                local against = flatV:Dot(want)
                if against < -10 then
                    local spd = math.clamp(math.max(flatV.Magnitude * 0.85, 18), 18, 52)
                    root.AssemblyLinearVelocity = Vector3.new(want.X * spd, v.Y, want.Z * spd)
                end
            end

            -- update lastGood only when progress or idle
            if want then
                if not prev then
                    _G.MoyaAntiBackLagV3.lastGood = pos
                else
                    local delta = pos - prev
                    local flatD = Vector3.new(delta.X, 0, delta.Z)
                    if flatD.Magnitude < 0.04 or flatD.Unit:Dot(want) >= -0.05 then
                        _G.MoyaAntiBackLagV3.lastGood = pos
                    end
                end
            else
                _G.MoyaAntiBackLagV3.lastGood = pos
            end
        end)
    end

    local sig = RunService.PreSimulation or RunService.Stepped
    _G.MoyaAntiBackLagV3.conn = sig:Connect(step)
    -- second pass after physics (catches late server corrections)
    _G.MoyaAntiBackLagV3.conn2 = RunService.Heartbeat:Connect(step)
end

