-- ============================================================
-- AUTO CARRY ON ENEMY BASE
-- Uses the existing Jox speed controls. It does NOT replace
-- the normal Auto Carry logic: while carrying/stealing, this
-- feature leaves speed ownership to Auto Carry / the player.
-- ============================================================
local function _joxIsMyPlot(plotName)
    LPH_ATTRIBUTES(VM(NONE))
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return false end
    local plot = plots:FindFirstChild(plotName)
    if not plot then return false end

    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yourBase = sign:FindFirstChild("YourBase")
        if yourBase and yourBase:IsA("BillboardGui") then
            return yourBase.Enabled == true
        end
    end
    return false
end

local function _joxIsNearEnemyBase(range)
    LPH_ATTRIBUTES(VM(NONE))
    range = tonumber(range) or tonumber(autoCarryEnemyBaseRange) or 35

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local plots = workspace:FindFirstChild("Plots")
    if not root or not plots then return false end

    local myPos = root.Position
    for _, plot in ipairs(plots:GetChildren()) do
        if plot and not _joxIsMyPlot(plot.Name) then
            local pos
            pcall(function()
                pos = plot:GetPivot().Position
            end)

            if not pos then
                local sign = plot:FindFirstChild("PlotSign")
                if sign and sign:IsA("BasePart") then
                    pos = sign.Position
                elseif sign then
                    local part = sign:FindFirstChildWhichIsA("BasePart", true)
                    if part then pos = part.Position end
                end
            end

            if pos then
                local flat = Vector3.new(myPos.X - pos.X, 0, myPos.Z - pos.Z)
                if flat.Magnitude <= range then
                    return true
                end
            end
        end
    end
    return false
end

local function _joxIsCarryingOrStealing(char)
    LPH_ATTRIBUTES(VM(NONE))
    char = char or LP.Character
    if not char then return false end
    if LP:GetAttribute("Stealing") == true then return true end

    for _, name in ipairs({"Carrying","IsCarrying","Grabbed","Holding","StealHold","HasGrab"}) do
        local v = char:FindFirstChild(name, true)
        if v then
            if v:IsA("BoolValue") and v.Value then return true end
            if v:IsA("ObjectValue") and v.Value then return true end
            if v:IsA("StringValue") and v.Value ~= "" then return true end
        end
    end

    for _, child in ipairs(char:GetChildren()) do
        -- Only named carry/steal objects count. A random model with a Humanoid
        -- or an unrelated equipped Tool can exist at round start and is not proof
        -- that the player is actually carrying a Brainrot.
        local n = tostring(child.Name or ""):lower()
        local looksLikeCarry = n:find("brainrot") or n:find("animal")
            or n:find("carry") or n:find("grab") or n:find("steal") or n:find("hold")
        if looksLikeCarry then
            if child:IsA("Model") or child:IsA("Tool") then
                if not (n:find("bat") or n:find("slap") or n:find("medusa")
                    or n:find("head") or n:find("stone")) then
                    return true
                end
            end
        end
    end
    return false
end

local function _joxGetSpeedMode()
    if laggerCarryActive then return "LaggerCarry" end
    if laggerModeEnabled then return "Lagger" end
    if carrySpeedActive then return "Carry" end
    return "Normal"
end

local function _joxRestoreSpeedMode(mode)
    if mode == "LaggerCarry" then
        pcall(setLaggerCarry)
    elseif mode == "Lagger" then
        pcall(setLaggerNormal)
    elseif mode == "Carry" then
        pcall(function() setNormalCarry(true) end)
    else
        pcall(function() setNormalSpeed(true) end)
    end
end

local function _joxStopEnemyBaseSpeed()
    LPH_ATTRIBUTES(VM(NONE))
    local S = _G.JoxAutoCarryEnemyBase
    if not S.applied then return end
    S.applied = false
    S.previousMode = nil
    -- If normal Auto Carry is currently controlling a real carry/steal session,
    -- do not take its speed control away.
    if _joxIsCarryingOrStealing(LP.Character) then return end
    -- Enemy-base Carry is temporary: once outside the enemy-base range (or
    -- when this toggle is disabled), explicitly return to Normal so Carry
    -- cannot remain latched from the enemy-base feature.
    pcall(function() setNormalSpeed(true) end)
end

local function _joxStartEnemyBaseSpeed()
    LPH_ATTRIBUTES(VM(NONE))
    local S = _G.JoxAutoCarryEnemyBase
    if S.applied and carrySpeedActive and not laggerModeEnabled and not laggerCarryActive then
        return
    end
    if not S.applied then
        S.previousMode = _joxGetSpeedMode()
    end
    S.applied = true
    pcall(function() setNormalCarry(true) end)
end

function _G.JoxStartAutoCarryEnemyBase()
    LPH_ATTRIBUTES(VM(NONE))
    local S = _G.JoxAutoCarryEnemyBase
    S.enabled = true
    S.lastNear = false
    if S.conn then return end

    S.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not S.enabled or autoCarryEnemyBaseEnabled ~= true then
            return
        end

        local char = LP.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            if S.applied and not _joxIsCarryingOrStealing(char) then
                _joxStopEnemyBaseSpeed()
            end
            S.lastNear = false
            return
        end

        local carryingOrStealing = _joxIsCarryingOrStealing(char)
        local near = _joxIsNearEnemyBase(autoCarryEnemyBaseRange)

        -- Never fight the regular Auto Carry while a carry/steal session
        -- is active. The regular system keeps control in that situation.
        if carryingOrStealing then
            S.lastNear = near
            return
        end

        if near then
            -- While this feature is enabled, being inside the configured
            -- radius owns the speed mode and keeps it on Carry.
            if not S.applied or not carrySpeedActive or laggerModeEnabled or laggerCarryActive then
                _joxStartEnemyBaseSpeed()
            end
        else
            if S.applied then
                _joxStopEnemyBaseSpeed()
            end
        end

        S.lastNear = near
    end)
end

