local infJumpRay = RaycastParams.new()
infJumpRay.FilterType = Enum.RaycastFilterType.Exclude

local function infJumpFloorStandY(r, hum, char)
    infJumpRay.FilterDescendantsInstances = { char }
    local hit = workspace:Raycast(r.Position + Vector3.new(0, 2.25, 0), Vector3.new(0, -200, 0), infJumpRay)
    if not hit then return nil, nil end
    local floorY = hit.Position.Y
    local standY = floorY + hum.HipHeight + r.Size.Y * 0.5 + 0.12
    return standY, floorY
end

local function infJumpCorrectSink(r, hum, _char, floorY, standY)
    if not floorY or not standY then return end
    if r.Position.Y >= floorY + 0.35 then return end
    r.CFrame = CFrame.new(r.Position.X, standY, r.Position.Z) * (r.CFrame - r.CFrame.Position)
    local v = r.Velocity
    r.Velocity = Vector3.new(v.X, math.max(0, v.Y), v.Z)
end

local function isJumpHeld()
    if UIS:IsKeyDown(Enum.KeyCode.Space) then return true end
    local ok, down = pcall(function()
        return UIS:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
    end)
    if ok and down then return true end
    return touchJumpHeld
end

local function doInfJumpBurst()
    if not infJumpActive then return end
    if _G._FRHUBTPDownJumpLocked then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    infJumpSession = infJumpSession + 1
    local session = infJumpSession

    local jy = 50
    if hum.UseJumpPower and hum.JumpPower > 0 then
        jy = hum.JumpPower
    else
        local jh = hum.JumpHeight
        if type(jh) == "number" and jh > 0 then
            jy = math.sqrt(math.max(0, 2 * workspace.Gravity * jh))
        end
    end
    jy = math.clamp(jy, 35, 95)

    local standY, floorY = infJumpFloorStandY(hrp, hum, char)
    infJumpCorrectSink(hrp, hum, char, floorY, standY)

    local v0 = hrp.Velocity
    hrp.Velocity = Vector3.new(v0.X, math.max(v0.Y * 0.15, jy), v0.Z)

    local postSim  = RunService.PostSimulation
    local waitPhys = (postSim and function() postSim:Wait() end)
                  or function() RunService.Heartbeat:Wait() end

    
end

local function startInfJumpHandler()
    if infJumpRenderConn then return end
    infJumpRenderConn = RunService.RenderStepped:Connect(function()
        if not infJumpActive then return end
        if not isJumpHeld() then return end
        local now = tick()
        if now - lastBurstTime < HOLD_INTERVAL then return end
        lastBurstTime = now
        doInfJumpBurst()
    end)
end

local function stopInfJumpHandler()
    if infJumpRenderConn then
        infJumpRenderConn:Disconnect()
        infJumpRenderConn = nil
    end
    infJumpSession = infJumpSession + 1
    lastBurstTime  = 0
    touchJumpHeld  = false
end

