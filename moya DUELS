-- Rogue Break: anti TP-down + anti left/right juke for aimbot
_G.rogueBreakEnabled = false
_G.RogueBreak = _G.RogueBreak or {
    enabled = false, conn = nil, prev = {}, side = 1, punishUntil = 0, focus = nil,
}
function _G.RogueBreak.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.rogueBreakEnabled = true
    _G.RogueBreak.enabled = true
    if _G.RogueBreak.conn then pcall(function() _G.RogueBreak.conn:Disconnect() end); _G.RogueBreak.conn=nil end
    _G.RogueBreak.prev = {}
    _G.RogueBreak.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.RogueBreak.enabled then return end
        if not (joxBatAimbotEnabled or aimbotV2Enabled) then return end
        pcall(function()
            local char = player and player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end
            local now = tick()
            local my = root.Position
            local bd, btr, bid = 40, nil, nil
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                    local th = plr.Character:FindFirstChildOfClass("Humanoid")
                    if tr and th and th.Health > 0 then
                        local d = (tr.Position - my).Magnitude
                        if d < bd then bd, btr, bid = d, tr, plr.UserId end
                    end
                end
            end
            if not btr or not bid then return end
            local pos = btr.Position
            local st = _G.RogueBreak.prev[bid]
            if not st then
                _G.RogueBreak.prev[bid] = {p=pos, t=now, side=1}
                return
            end
            local dt = math.max(now - st.t, 1/240)
            local disp = pos - st.p
            local flat = Vector3.new(disp.X, 0, disp.Z)
            local vel = flat / dt
            st.p, st.t = pos, now
            local tpDown = (disp.Y < -6 and flat.Magnitude < 22) or (disp.Y / dt < -55 and flat.Magnitude < 18)
            if tpDown and now - (st.lastTP or 0) > 0.35 then
                st.lastTP = now
                local land = Vector3.new(pos.X, pos.Y, pos.Z)
                pcall(function()
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local excl = {}
                    for _, p in ipairs(Players:GetPlayers()) do if p.Character then excl[#excl+1]=p.Character end end
                    params.FilterDescendantsInstances = excl
                    local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -200, 0), params)
                    if hit then land = Vector3.new(pos.X, hit.Position.Y + 3.1, pos.Z) end
                end)
                local back = Vector3.new(my.X - land.X, 0, my.Z - land.Z)
                back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0, 0, 1)
                local side = Vector3.new(-back.Z, 0, back.X) * (st.side or 1)
                local stand = land + back * 3.2 + side * 1.2
                root.CFrame = CFrame.new(stand, Vector3.new(land.X, stand.Y, land.Z))
                root.AssemblyLinearVelocity = Vector3.new(0, -40, 0)
                _G.RogueBreak.punishUntil = now + 0.3
                _G.RogueBreak.focus = btr
            end
            local to = Vector3.new(pos.X - my.X, 0, pos.Z - my.Z)
            if to.Magnitude > 0.2 and vel.Magnitude > 10 then
                local approach = to.Unit
                if approach:Dot(vel.Unit) < -0.15 then
                    local cutSide = Vector3.new(-approach.Z, 0, approach.X)
                    if vel:Dot(cutSide) < 0 then cutSide = -cutSide end
                    local cut = (approach * 0.55 + cutSide * 0.6).Unit
                    local v = root.AssemblyLinearVelocity
                    local spd = math.clamp(bd * 2.4, 24, 62)
                    root.AssemblyLinearVelocity = Vector3.new(v.X + (cut.X * spd - v.X) * 0.35, v.Y, v.Z + (cut.Z * spd - v.Z) * 0.35)
                end
            end
            local dy = pos.Y - my.Y
            if math.abs(dy) > 2.5 and bd < 22 then
                local v = root.AssemblyLinearVelocity
                if dy > 2.5 then
                    root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, math.clamp(dy * 18, 28, 90)), v.Z)
                    hum.Jump = true
                else
                    root.AssemblyLinearVelocity = Vector3.new(v.X, math.min(v.Y, math.clamp(dy * 20, -95, -12)), v.Z)
                end
            end
            if now < (_G.RogueBreak.punishUntil or 0) and _G.RogueBreak.focus and _G.RogueBreak.focus.Parent then
                local tpos = _G.RogueBreak.focus.Position
                local flat2 = Vector3.new(tpos.X - my.X, 0, tpos.Z - my.Z)
                if flat2.Magnitude > 0.1 then
                    local face = CFrame.lookAt(my, Vector3.new(tpos.X, my.Y, tpos.Z))
                    root.CFrame = CFrame.new(my) * (face - face.Position)
                    if flat2.Magnitude > 3 and flat2.Magnitude < 12 then
                        local n = flat2.Unit
                        local v = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(v.X + n.X * 18, math.min(v.Y, -8), v.Z + n.Z * 18)
                    end
                end
                if autoSwingEnabled ~= false then
                    local bat = char:FindFirstChildOfClass("Tool")
                    if bat then pcall(function() bat:Activate() end) end
                end
            end
        end)
    end)
end
function _G.RogueBreak.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.rogueBreakEnabled = false
    _G.RogueBreak.enabled = false
    if _G.RogueBreak.conn then pcall(function() _G.RogueBreak.conn:Disconnect() end); _G.RogueBreak.conn=nil end
end

