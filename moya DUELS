        if not tr.Parent then return end
        local tpos = tr.Position
        local flat = Vector3.new(tpos.X - my.X, 0, tpos.Z - my.Z)
        if flat.Magnitude < 0.1 or flat.Magnitude > 30 then return end
        local dir = flat.Unit
