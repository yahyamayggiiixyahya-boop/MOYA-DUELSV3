    end)

    _G.SilkPlay.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.SilkPlay.enabled then return end
        pcall(function()
            local char = player and player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end

            -- 1) smooth move: kill spin + soft velocity spikes only
            local av = root.AssemblyAngularVelocity
            if av.Magnitude > 18 then
                root.AssemblyAngularVelocity = av * 0.25
            end
            local v = root.AssemblyLinearVelocity
            if v.Magnitude > 220 then
                root.AssemblyLinearVelocity = v.Unit * 90
            end
            if hum.PlatformStand then hum.PlatformStand = false end

            -- 2) move feel: slight blend toward MoveDirection (silk, not speed hack)
            local md = hum.MoveDirection
            if md.Magnitude > 0.1 and not joxBatAimbotEnabled and not aimbotV2Enabled then
                local flat = Vector3.new(v.X, 0, v.Z)
                local target = md.Unit * math.clamp(hum.WalkSpeed, 14, 28)
                root.AssemblyLinearVelocity = Vector3.new(
                    flat.X + (target.X - flat.X) * 0.14,
                    v.Y,
                    flat.Z + (target.Z - flat.Z) * 0.14
                )
            end

            -- 3) hit help: only when bat out and enemy very close (cheap scan)
            local bat = char:FindFirstChildOfClass("Tool")
            if bat and autoSwingEnabled ~= false then
                local my = root.Position
                local best, bd = nil, 7
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character then
                        local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                        local th = plr.Character:FindFirstChildOfClass("Humanoid")
                        if tr and th and th.Health > 0 then
                            local d = (tr.Position - my).Magnitude
                            if d < bd then bd, best = d, tr end
                        end
                    end
                end
                if best and bd <= 6.5 and not _G.SilkPlay.swingCd then
                    local look = root.CFrame.LookVector
                    local to = best.Position - my
                    local flat = Vector3.new(to.X, 0, to.Z)
                    if flat.Magnitude > 0.1 and look:Dot(flat.Unit) > 0.4 then
                        _G.SilkPlay.swingCd = true
                        pcall(function() bat:Activate() end)
                        -- micro face only
                        pcall(function()
                            local face = CFrame.lookAt(my, Vector3.new(best.Position.X, my.Y, best.Position.Z))
                            root.CFrame = root.CFrame:Lerp(CFrame.new(my) * (face - face.Position), 0.2)
                        end)
                        task.delay(0.14, function() _G.SilkPlay.swingCd = false end)
                    end
                end
            end
        end)
    end)
end

