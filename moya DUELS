  {k="SweetSpot", n="Sweet Spot", g="Hit"},
  {k="ConeTap", n="Cone Tap", g="Hit"},
  {k="LateSwing", n="Late Swing", g="Hit"},
  {k="BatStick", n="Bat Stick", g="Hit"},
  {k="MeleeGap", n="Melee Gap", g="Hit"},
  -- Stability / clean play (38-40)
  {k="VelSmooth", n="Vel Smooth", g="Stab"},
  {k="NoSpin", n="No Spin", g="Stab"},
  {k="OwnHold", n="Own Hold", g="Stab"},
}

local function mlOn(k) return ML.on[k] == true end
local function mlRayGround(pos, excl)
    local gy = pos.Y - 3
    pcall(function()
        local pr = RaycastParams.new()
        pr.FilterType = Enum.RaycastFilterType.Exclude
        pr.FilterDescendantsInstances = excl or {}
        local r = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -240, 0), pr)
        if r then gy = r.Position.Y end
    end)
    return gy
end
local function mlNearest(root, maxD)
    local best, bd = nil, maxD or 40
    local my = root.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            local th = plr.Character:FindFirstChildOfClass("Humanoid")
            if tr and th and th.Health > 0 then
                local d = (tr.Position - my).Magnitude
                if d < bd then bd, best = d, {tr=tr, plr=plr, d=d, th=th} end
            end
        end
    end
    return best
end
local function mlBat(char, hum)
    local t = char:FindFirstChildOfClass("Tool")
    if t then return t end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, x in ipairs(bp:GetChildren()) do
            if x:IsA("Tool") then
                local n = x.Name:lower()
                if n:find("bat") or n:find("slap") then
                    pcall(function() hum:EquipTool(x) end)
                    return x
                end
            end
        end
    end
    return nil
end

function ML.start()
    LPH_ATTRIBUTES(VM(NONE))
    if ML.conn then pcall(function() ML.conn:Disconnect() end) end
    ML.mem = ML.mem or {}
    ML.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        local any = false
        for _, d in ipairs(ML.defs) do if ML.on[d.k] then any = true break end end
        if not any then return end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then return end
        local now = tick()
        local my = root.Position
        local v = root.AssemblyLinearVelocity
        local excl = {}
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then excl[#excl+1]=p.Character end end
        local mem = ML.mem

        -- per-enemy sample for TP/juke
        mem.samp = mem.samp or {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local id = plr.UserId
                    local s = mem.samp[id]
                    if not s then s = {buf={}, lastDir=Vector3.zero, lastTP=0}; mem.samp[id]=s end
                    local pos = tr.Position
                    s.buf[#s.buf+1] = {t=now, p=pos}
                    while #s.buf > 10 do table.remove(s.buf, 1) end
                    local vel = tr.AssemblyLinearVelocity
                    local fdir = Vector3.new(vel.X,0,vel.Z)
                    fdir = fdir.Magnitude > 2 and fdir.Unit or s.lastDir
                    local juke = (s.lastDir.Magnitude > 0.1 and fdir.Magnitude > 0.1 and s.lastDir:Dot(fdir) < 0.2)
                    s.lastDir = fdir
                    s.juke = juke
                    if #s.buf >= 3 then
                        local a,b = s.buf[#s.buf-2], s.buf[#s.buf]
                        local disp = b.p - a.p
                        local flat = Vector3.new(disp.X,0,disp.Z)
                        local dt = math.max(b.t-a.t,1/240)
                        s.tpDown = (disp.Y < -6 and flat.Magnitude < 20) or (disp.Y/dt < -50 and flat.Magnitude < 25)
                        s.land = Vector3.new(b.p.X, mlRayGround(b.p, excl)+3.05, b.p.Z)
                        s.tr = tr
                    end
                end
            end
        end

        local near = mlNearest(root, 45)
        local aimOn = joxBatAimbotEnabled or aimbotV2Enabled

        -- === TP family ===
        if near and near.tr then
            local id = near.plr.UserId
            local s = mem.samp[id]
            if s and s.tpDown and (now - (s.lastTP or 0) > 0.35) then
                s.lastTP = now
                local land = s.land or near.tr.Position
                local back = Vector3.new(my.X-land.X,0,my.Z-land.Z)
                back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0,0,1)
                local side = Vector3.new(-back.Z,0,back.X)
                local stand = land + back*3.2
                if mlOn("PadSide") then stand = stand + side*1.3 end
                if mlOn("DiveRead") or mlOn("LandPad") or mlOn("FallSnap") or mlOn("GroundPin") or mlOn("SinkChase") or mlOn("PadSide") then
                    pcall(function()
                        root.CFrame = CFrame.new(stand, Vector3.new(land.X, stand.Y, land.Z))
                        local yv = mlOn("FallSnap") and -55 or -28
                        root.AssemblyLinearVelocity = Vector3.new(0, yv, 0)
                    end)
                    mem.punish = now + (mlOn("PunishBeat") and 0.32 or 0.2)
                    mem.focus = near.tr
                end
            end
        end
        if mem.punish and now < mem.punish and mem.focus and mem.focus.Parent then
            local tpos = mem.focus.Position
            if mlOn("DropGlue") or mlOn("VerticalLock") or mlOn("PunishBeat") or mlOn("GroundPin") then
                local flat = Vector3.new(tpos.X-my.X,0,tpos.Z-my.Z)
                if flat.Magnitude > 0.1 then
                    pcall(function()
                        root.CFrame = CFrame.new(my) * (CFrame.lookAt(my, Vector3.new(tpos.X,my.Y,tpos.Z)) - my)
                    end)
                    if flat.Magnitude > 3 and flat.Magnitude < 12 then
                        local n = flat.Unit
                        root.AssemblyLinearVelocity = Vector3.new(v.X+n.X*18, math.min(v.Y,-6), v.Z+n.Z*18)
                    end
                end
                if mlOn("VerticalLock") then
                    local dy = tpos.Y - root.Position.Y
                    if math.abs(dy) > 1 then
                        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, math.clamp(dy*20,-80,60), root.AssemblyLinearVelocity.Z)
                    end
                end
                if (mlOn("PunishBeat") or mlOn("DropGlue")) and autoSwingEnabled ~= false then
                    local bat = mlBat(char, hum)
                    if bat then pcall(function() bat:Activate() end) end
                end
            end
            if mlOn("AirCut") and (tpos.Y - root.Position.Y) < -2 then
                root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, math.min(root.AssemblyLinearVelocity.Y, -40), root.AssemblyLinearVelocity.Z)
            end
        end

        -- === Juke family ===
        if near and near.tr and near.d < 28 then
            local s = mem.samp[near.plr.UserId]
            local tpos = near.tr.Position
            local flat = Vector3.new(tpos.X-my.X,0,tpos.Z-my.Z)
            local toT = flat.Magnitude > 0.1 and flat.Unit or Vector3.zero
            local tvel = near.tr.AssemblyLinearVelocity
            local tflat = Vector3.new(tvel.X,0,tvel.Z)
            if s and s.juke then
                if mlOn("MirrorBreak") or mlOn("InverseDeny") then
                    -- don't chase their mirror: cut perpendicular then in
                    local side = Vector3.new(-toT.Z, 0, toT.X)
                    local push = (side * 22) + (toT * 12)
                    root.AssemblyLinearVelocity = Vector3.new(v.X*0.5+push.X, v.Y, v.Z*0.5+push.Z)
                end
                if mlOn("CrossStep") then
                    local side = Vector3.new(-toT.Z, 0, toT.X) * ((now*3)%2 < 1 and 1 or -1)
                    root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*16, v.Y, v.Z+side.Z*16)
                end
                if mlOn("TurnPunish") and near.d < 10 then
                    local bat = mlBat(char, hum)
                    if bat and autoSwingEnabled ~= false then pcall(function() bat:Activate() end) end
                end
            end
            if mlOn("StrafeRead") and tflat.Magnitude > 12 then
                local pred = tpos + tflat.Unit * math.min(tflat.Magnitude*0.12, 8)
                local pf = Vector3.new(pred.X-my.X,0,pred.Z-my.Z)
                if pf.Magnitude > 0.2 then
                    local d = pf.Unit
                    root.AssemblyLinearVelocity = Vector3.new(v.X+d.X*10, v.Y, v.Z+d.Z*10)
                end
            end
            if mlOn("SideCut") and near.d < 14 then
                local side = Vector3.new(-toT.Z,0,toT.X)
                root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*8+toT.X*10, v.Y, v.Z+side.Z*8+toT.Z*10)
            end
            if mlOn("FakeCommit") and near.d < 16 then
                -- brief pause lateral then commit (breaks their inverse read)
                if (now % 0.5) < 0.12 then
                    root.AssemblyLinearVelocity = Vector3.new(v.X*0.3, v.Y, v.Z*0.3)
                end
            end
            if mlOn("PathHold") and aimOn and toT.Magnitude > 0 then
                local along = toT * Vector3.new(v.X,0,v.Z):Dot(toT)
                local side = Vector3.new(v.X,0,v.Z) - along
                local cleaned = along + side*0.25
                root.AssemblyLinearVelocity = Vector3.new(cleaned.X, v.Y, cleaned.Z)
            end
        end

        -- === Defense: harder to hit you ===
        if near and near.d < 12 then
            local tpos = near.tr.Position
            local flat = Vector3.new(tpos.X-my.X,0,tpos.Z-my.Z)
            local away = flat.Magnitude > 0.1 and -flat.Unit or root.CFrame.LookVector
            local side = Vector3.new(-away.Z,0,away.X)
            if mlOn("GhostSway") then
                local w = math.sin(now*9) * 14
                root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*w*0.15, v.Y, v.Z+side.Z*w*0.15)
            end
            if mlOn("AngleBreak") then
                local look = root.CFrame.LookVector
                if flat.Magnitude > 0.1 and look:Dot(flat.Unit) > 0.7 then
                    root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*20, v.Y, v.Z+side.Z*20)
                end
            end
            if mlOn("MicroOrbit") then
                local o = side * (12 + 6*math.sin(now*6)) + away * -4
                root.AssemblyLinearVelocity = Vector3.new(v.X*0.7+o.X*0.3, v.Y, v.Z*0.7+o.Z*0.3)
            end
            if mlOn("AntiFace") then
                -- face slightly off their look-at so their bat cone misses
                local off = CFrame.lookAt(my, my + side)
                pcall(function() root.CFrame = root.CFrame:Lerp(CFrame.new(my)*(off-my), 0.2) end)
            end
            if mlOn("PulseStep") and (now - (mem.lastPulse or 0) > 0.35) and near.d < 7 then
                mem.lastPulse = now
                root.AssemblyLinearVelocity = Vector3.new(away.X*35, 28, away.Z*35)
            end
            if mlOn("SlipEdge") and near.d < 6 then
                root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*25, v.Y, v.Z+side.Z*25)
            end
            if mlOn("LookOff") then
                hum.AutoRotate = false
            end
            if mlOn("RangeFog") and near.d < 5.5 then
                root.AssemblyLinearVelocity = Vector3.new(v.X+away.X*18, v.Y+8, v.Z+away.Z*18)
            end
        end

        -- === Self dive tools ===
        local gY = mlRayGround(my, excl)
        if mlOn("SelfDive") and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
            -- hold jump+crouch style sink when key space not required: auto when enemy above far
            if near and (near.tr.Position.Y - my.Y) > 6 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, math.min(v.Y, -60), v.Z)
            end
        end
        if mlOn("FastSink") then
            if v.Y < -5 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, math.min(v.Y*1.35, -90), v.Z)
            end
        end
        if mlOn("SnapFloor") and (my.Y - gY) > 8 and (my.Y - gY) < 40 then
            if near and near.d < 20 then
                -- snap down toward ground once per 0.6s
                if now - (mem.snapF or 0) > 0.6 then
                    mem.snapF = now
                    pcall(function()
                        root.CFrame = CFrame.new(my.X, gY+3.1, my.Z) * (root.CFrame - root.Position)
                        root.AssemblyLinearVelocity = Vector3.new(v.X, -20, v.Z)
                    end)
                end
            end
        end
        if mlOn("DropDash") and v.Y < -20 then
            local look = root.CFrame.LookVector
            root.AssemblyLinearVelocity = Vector3.new(look.X*40, v.Y, look.Z*40)
        end
        if mlOn("LowProfile") and (my.Y - gY) < 5 then
            -- slight crouch velocity damp for smaller target profile feel
            if v.Magnitude > 30 then
                root.AssemblyLinearVelocity = v.Unit * (v.Magnitude * 0.92)
            end
        end
        if mlOn("RiseCut") and v.Y > 40 then
            root.AssemblyLinearVelocity = Vector3.new(v.X, v.Y*0.7, v.Z)
        end

        -- === Hit intelligence ===
        if near and near.d < 9 then
            local tpos = near.tr.Position
            local flat = Vector3.new(tpos.X-my.X,0,tpos.Z-my.Z)
            local look = root.CFrame.LookVector
            local toT = flat.Magnitude > 0.1 and flat.Unit or Vector3.zero
            local inCone = toT.Magnitude > 0 and look:Dot(toT) > 0.55
            if mlOn("SweetSpot") and near.d > 3.5 and near.d < 6.5 and toT.Magnitude > 0 then
                root.AssemblyLinearVelocity = Vector3.new(v.X+toT.X*12, v.Y, v.Z+toT.Z*12)
            end
            if mlOn("MeleeGap") and near.d > 6 and near.d < 11 and toT.Magnitude > 0 then
                root.AssemblyLinearVelocity = Vector3.new(v.X+toT.X*16, v.Y, v.Z+toT.Z*16)
            end
            if mlOn("BatStick") and near.d < 5.5 then
                pcall(function()
                    local face = CFrame.lookAt(my, Vector3.new(tpos.X,my.Y,tpos.Z))
                    root.CFrame = root.CFrame:Lerp(CFrame.new(my)*(face-my), 0.4)
                end)
            end
            local bat = char:FindFirstChildOfClass("Tool")
            if bat and autoSwingEnabled ~= false then
                if mlOn("ConeTap") and inCone and near.d < 7.5 then
                    pcall(function() bat:Activate() end)
                end
                if mlOn("LateSwing") and near.d < 5 and inCone then
                    pcall(function() bat:Activate() end)
                end
            end
        end

        -- === Stability ===
        if mlOn("VelSmooth") then
            local pv = mem.prevV
            if pv then
                root.AssemblyLinearVelocity = pv:Lerp(root.AssemblyLinearVelocity, 0.55)
            end
            mem.prevV = root.AssemblyLinearVelocity
        end
        if mlOn("NoSpin") and root.AssemblyAngularVelocity.Magnitude > 18 then
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if mlOn("OwnHold") then
            pcall(function() if root.SetNetworkOwner then root:SetNetworkOwner(LP) end end)
        end
    end)
end

