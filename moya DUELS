        root.AssemblyLinearVelocity = Vector3.new(v.X, _G.InfiniteJump.jumpPower, v.Z)
    end
    if v.Y < _G.InfiniteJump.maxFallVelocity then
        root.AssemblyLinearVelocity = Vector3.new(v.X, _G.InfiniteJump.maxFallVelocity, v.Z)
    end
end

