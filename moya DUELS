local function _adv2HookHum(hum, char)
    LPH_ATTRIBUTES(VM(NONE))
    if not hum then return end
    if _G.AntiDieV2.healthConn then pcall(function() _G.AntiDieV2.healthConn:Disconnect() end); _G.AntiDieV2.healthConn=nil end
    if _G.AntiDieV2.stateConn then pcall(function() _G.AntiDieV2.stateConn:Disconnect() end); _G.AntiDieV2.stateConn=nil end
    _G.AntiDieV2.hum = hum
    pcall(function()
        LPH_ATTRIBUTES(VM(NONE))
        hum.BreakJointsOnDeath = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Dying, false)
        if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
    _G.AntiDieV2.healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.AntiDieV2.enabled or _G.MOYA_ALLOW_RESET then return end
        if not hum.Parent then return end
        if hum.Health < hum.MaxHealth then
            pcall(function() hum.Health = hum.MaxHealth end)
        end
    end)
    _G.AntiDieV2.stateConn = hum.StateChanged:Connect(function(_, newState)
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.AntiDieV2.enabled or _G.MOYA_ALLOW_RESET then return end
        if newState == Enum.HumanoidStateType.Dead or newState == Enum.HumanoidStateType.Dying then
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                hum.Health = hum.MaxHealth
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end)
end

function _G.AntiDieV2.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.AntiDieV2.enabled = true
    _G.antiDieV2Enabled = true
    if _G.AntiDieV2.hbConn then pcall(function() _G.AntiDieV2.hbConn:Disconnect() end); _G.AntiDieV2.hbConn=nil end
    if _G.AntiDieV2.charConn then pcall(function() _G.AntiDieV2.charConn:Disconnect() end); _G.AntiDieV2.charConn=nil end

    local function onChar(char)
        LPH_ATTRIBUTES(VM(NONE))
        if not char then return end
        task.defer(function()
            LPH_ATTRIBUTES(VM(NONE))
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
            if hum and _G.AntiDieV2.enabled then _adv2HookHum(hum, char) end
        end)
    end

    _G.AntiDieV2.charConn = LP.CharacterAdded:Connect(onChar)
    if LP.Character then onChar(LP.Character) end

    -- continuous guard + smooth velocity (reduce server snap/reset)
    _G.AntiDieV2.hbConn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.AntiDieV2.enabled then return end
        if _G.MOYA_ALLOW_RESET then return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Dying, false)
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            if hum.PlatformStand then hum.PlatformStand = false end
            -- smooth extreme velocity spikes that often cause force-reset
            local v = root.AssemblyLinearVelocity
            if v.Magnitude > 280 then
                root.AssemblyLinearVelocity = v.Unit * 90
            end
            local av = root.AssemblyAngularVelocity
            if av.Magnitude > 40 then
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end)
end

function _G.AntiDieV2.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.AntiDieV2.enabled = false
    _G.antiDieV2Enabled = false
    if _G.AntiDieV2.hbConn then pcall(function() _G.AntiDieV2.hbConn:Disconnect() end); _G.AntiDieV2.hbConn=nil end
    if _G.AntiDieV2.charConn then pcall(function() _G.AntiDieV2.charConn:Disconnect() end); _G.AntiDieV2.charConn=nil end
    if _G.AntiDieV2.healthConn then pcall(function() _G.AntiDieV2.healthConn:Disconnect() end); _G.AntiDieV2.healthConn=nil end
    if _G.AntiDieV2.stateConn then pcall(function() _G.AntiDieV2.stateConn:Disconnect() end); _G.AntiDieV2.stateConn=nil end
    local hum = _G.AntiDieV2.hum
    _G.AntiDieV2.hum = nil
    if hum and hum.Parent then
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            hum.BreakJointsOnDeath = true
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Dying, true)
        end)
    end
end

-- Hit Assist: soft face + range-keep when enemy is close with bat.
-- Not full aimbot — low force so server rarely snaps. Optional.
_G.hitAssistEnabled = false
_G.HitAssist = _G.HitAssist or {enabled=false, conn=nil, swingCd=false, sticky=nil, stickyUntil=0}

local function _haFindBat(char)
    if not char then return nil end
    local t = char:FindFirstChildOfClass("Tool")
    if t then return t end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, x in ipairs(bp:GetChildren()) do
            if x:IsA("Tool") then
                local n = x.Name:lower()
                if n:find("bat") or n:find("slap") then return x end
            end
        end
    end
    return nil
end

local function _haClosest(root)
    local best, bestD = nil, 14
    local my = root.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            local th = plr.Character:FindFirstChildOfClass("Humanoid")
            if tr and th and th.Health > 0 then
                local d = (tr.Position - my).Magnitude
                if d < bestD then bestD, best = d, tr end
            end
        end
    end
    return best, bestD
end

function _G.HitAssist.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.HitAssist.enabled = true
    _G.hitAssistEnabled = true
    if _G.HitAssist.conn then pcall(function() _G.HitAssist.conn:Disconnect() end); _G.HitAssist.conn=nil end
    _G.HitAssist.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.HitAssist.enabled then return end
        -- don't fight full aimbot when it's already driving
        if joxBatAimbotEnabled or aimbotV2Enabled then return end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then return end

        local bat = char:FindFirstChildOfClass("Tool") or _haFindBat(char)
        if not bat then return end
        if bat.Parent ~= char then
            pcall(function() hum:EquipTool(bat) end)
        end

        local target, dist = _haClosest(root)
        if not target then return end

        local myPos = root.Position
        local tPos = target.Position
        local flat = Vector3.new(tPos.X - myPos.X, 0, tPos.Z - myPos.Z)
        local fm = flat.Magnitude

        -- soft face only (no hard lock)
        if fm > 0.2 then
            local look = CFrame.lookAt(myPos, Vector3.new(tPos.X, myPos.Y, tPos.Z))
            local _, y, _ = look:ToEulerAnglesYXZ()
            local cur = root.CFrame
            local blend = cur:Lerp(CFrame.new(myPos) * CFrame.Angles(0, y, 0), 0.22)
            pcall(function()
                root.CFrame = CFrame.new(myPos) * (blend - blend.Position)
            end)
        end

        -- micro keep-in-range: only if slightly out of bat range but still close
        if dist > 5.5 and dist < 12 and fm > 0.15 then
            local dir = flat.Unit
            local v = root.AssemblyLinearVelocity
            local push = dir * 18
            root.AssemblyLinearVelocity = Vector3.new(
                v.X * 0.7 + push.X * 0.3,
                v.Y,
                v.Z * 0.7 + push.Z * 0.3
            )
        end

        -- swing when in sweet spot and roughly facing
        if dist <= 7 and not _G.HitAssist.swingCd and autoSwingEnabled ~= false then
            local look = root.CFrame.LookVector
            local toT = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
            if toT.Magnitude > 0 and look:Dot(toT) > 0.35 then
                _G.HitAssist.swingCd = true
                pcall(function()
                    local b = char:FindFirstChildOfClass("Tool")
                    if b then b:Activate() end
                end)
                task.delay(0.14, function() _G.HitAssist.swingCd = false end)
            end
        end
    end)
end

