    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return false end

    -- turn off conflicting Jox movement features
    pcall(function()
        LPH_ATTRIBUTES(VM(NONE))
        if joxBatAimbotEnabled then stopJoxBatAimbot() end
        if autoLeftEnabled then stopAutoLeft() end
        if autoRightEnabled then stopAutoRight() end
        if joxAntiBatBypassEnabled then
            joxAntiBatBypassEnabled = false
            pcall(stopJoxAntiBatBypass)
            pcall(setVisual, "AntiBatBypass", false)
        end
    end)

    NanzV3.on = true
    nanzFreezeInput(true) -- player can't walk; the aimbot does the chasing
    humanoid.AutoRotate = false
    local tool = nanzFindBat()
    if tool and tool.Parent ~= character then
        pcall(function() humanoid:EquipTool(tool) end)
    end
    local rootRef, humRef, toolRef = rootPart, humanoid, tool
    NanzV3.conn = RunService.RenderStepped:Connect(function(deltaTime)
        LPH_ATTRIBUTES(VM(NONE))
        if nanzBypasSession ~= _G.__NanzBypasSession then nanzV3Stop(); nanzFreezeInput(false); return end
        if not NanzV3.on then nanzV3Stop(); return end
        local z = NanzV3.Z
        local zcfg = NanzV3.ZCFG
        local isLagger = (laggerModeEnabled == true) or (laggerCarryActive == true)
        local settings = JoxAimbotSettings or {}
        if isLagger then
            zcfg.FOLLOW_SPEED = NanzV3.cap(settings.bypassLaggerSpeed, NanzV3.SPD.LAG)
        else
            zcfg.FOLLOW_SPEED = NanzV3.cap(settings.bypassSpeed, NanzV3.SPD.V1)
        end
        local character2 = LP.Character
        local rootPart1394 = character2 and character2:FindFirstChild("HumanoidRootPart")
        local humanoid2 = character2 and character2:FindFirstChildOfClass("Humanoid")
        if not rootPart1394 or not humanoid2 or humanoid2.Health <= 0 then return end
        humanoid2.AutoRotate = false
        rootRef = rootPart1394
        humRef = humanoid2
        toolRef = character2:FindFirstChildOfClass("Tool") or nanzFindBat()
        if toolRef and toolRef.Parent ~= character2 then
            pcall(humRef.EquipTool, humRef, toolRef)
        end
        z.targetPlayer = nanzV3Closest(rootRef)
        local character3 = z.targetPlayer and z.targetPlayer.Character
        local rootPart1442 = character3 and character3:FindFirstChild("HumanoidRootPart")
        local hum3 = character3 and character3:FindFirstChildOfClass("Humanoid")
        if not rootPart1442 or not hum3 or hum3.Health <= 0 then
            nanzV3ResetPrediction()
            return
        end
        local position = rootPart1442.Position
        local sampleDeltaTime = math.max(deltaTime, 0.0041666666666666666)
        if z.lastTargetPos then
            local targetVelocity = (position - z.lastTargetPos) / sampleDeltaTime
            local vector = targetVelocity - z.targetVelocity
            if zcfg.MAX_VELOCITY_CHANGE < vector.Magnitude then
                targetVelocity = z.targetVelocity + vector.Unit * zcfg.MAX_VELOCITY_CHANGE
            end
            local vector3 = Vector3.new(targetVelocity.X, 0, targetVelocity.Z)
            if vector3.Magnitude > zcfg.MAX_HORIZONTAL_VELOCITY then
                local vectorH = vector3.Unit * zcfg.MAX_HORIZONTAL_VELOCITY
                targetVelocity = Vector3.new(vectorH.X, targetVelocity.Y, vectorH.Z)
            end
            table.insert(z.accelerationHistory, (targetVelocity - z.targetVelocity) / sampleDeltaTime)
            if #z.accelerationHistory > 4 then table.remove(z.accelerationHistory, 1) end
            table.insert(z.velocityHistory, targetVelocity)
            if #z.velocityHistory > 8 then table.remove(z.velocityHistory, 1) end
            z.targetVelocity = targetVelocity
            z.smoothedVelocity = z.smoothedVelocity:Lerp(targetVelocity, zcfg.VELOCITY_SMOOTHING)
        end
        z.lastTargetPos = position
        local ax = NanzV3.AX
        local nowT = tick()
        if ax.track(rootPart1442, nowT) and (position - rootRef.Position).Magnitude <= 300 then
            ax.snapUntil = nowT + 0.2 -- target TP'd: jump right on it
        end
        if nowT < ax.snapUntil then
            ax.snap(rootRef, rootPart1442)
            if toolRef and autoSwingEnabled ~= false then pcall(toolRef.Activate, toolRef) end
            return
        end
        local tv = ax.vel
        local lead = math.clamp(z.currentPing + zcfg.SERVER_TICKRATE + 0.05, 0.08, 0.3)
        local leadPosition = position + Vector3.new(tv.X, 0, tv.Z) * lead
        local targetDirection = leadPosition - rootRef.Position
        nanzV3Aim(rootRef, targetDirection)
        local withinActivationRange = (position - rootRef.Position).Magnitude <= zcfg.ACTIVATE_DISTANCE
        if withinActivationRange then
            withinActivationRange = tick() - z.lastActivationTime >= 0.3
        end
        if withinActivationRange then
            if toolRef and autoSwingEnabled ~= false then
                pcall(toolRef.Activate, toolRef)
            end
            z.lastActivationTime = tick()
        end
        ax.chase(rootRef, rootPart1442, leadPosition, zcfg.FOLLOW_SPEED, zcfg.MIN_FOLLOW_DISTANCE)
    end)
    return true
end

-- ------------------------------------------------------------
-- AIMBOT BYPAS V2 (NANZ/MVP "Bat Bypass" engine):
-- nearest-target lock every frame, ping + acceleration +
-- aerial prediction, velocity chase, auto swing
-- (Activate + RemoteEvent) inside 13 studs.
-- ------------------------------------------------------------
AIMBOT_BYPAS_VERSION = "V1"
setAimbotBypasVersion = nil

do
    local BypasV2 = {
        enabled = false, conn = nil,
        targetPlayer = nil, lastTargetPos = nil,
        targetVelocity = Vector3.zero, smoothedVelocity = Vector3.zero,
        velocityHistory = {}, accelerationHistory = {}, aerialVelocityHistory = {}, verticalVelocityHistory = {},
        previousDirection = nil, lastDirectionChangeTime = 0, airborneTime = 0,
        lastYVelocity = 0, lastJumpTime = 0, lastActivationTime = 0,
        currentPing = 0.1, realPingMs = 0,
        previousAutoRotate = nil, swingLocked = false, nextSwingAt = 0,
    }
    local BV2CFG = {
        ACTIVATE_DISTANCE = 13, MIN_FOLLOW_DISTANCE = 1,
        PREDICTION_TIME = 0.22, PREDICT_AHEAD = 3,
        MAX_VELOCITY_CHANGE = 150, VELOCITY_SMOOTHING = 0.2,
        MAX_HORIZONTAL_VELOCITY = 80, SERVER_TICKRATE = 1/60,
        MIN_PING_COMPENSATION = 0.03, MAX_PING_COMPENSATION = 0.25,
        ACCELERATION_PREDICTION_WEIGHT = 0.3,
        DIRECTION_CHANGE_DETECTION_TIME = 0.12,
        QUICK_DIRECTION_CHANGE_MULTIPLIER = 1.5,
        GRAVITY = 196.2, AIR_CONTROL_FACTOR = 0.8,
        MIN_AIRBORNE_TIME = 0.08, SWING_COOLDOWN = 0.08,
    }

    local function bv2Reset()
        LPH_ATTRIBUTES(VM(NONE))
        BypasV2.targetPlayer = nil
        BypasV2.lastTargetPos = nil
        BypasV2.targetVelocity = Vector3.zero
        BypasV2.smoothedVelocity = Vector3.zero
        BypasV2.velocityHistory = {}
        BypasV2.accelerationHistory = {}
        BypasV2.aerialVelocityHistory = {}
        BypasV2.verticalVelocityHistory = {}
        BypasV2.previousDirection = nil
        BypasV2.airborneTime = 0
        BypasV2.lastYVelocity = 0
    end

    local function bv2FindNearest(myRoot)
        LPH_ATTRIBUTES(VM(NONE))
        local plr = NanzV3.AX.pick(myRoot)
        local r = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        return plr, r and (r.Position - myRoot.Position).Magnitude or math.huge
    end

    local function bv2FaceTarget(myRoot, direction)
        LPH_ATTRIBUTES(VM(NONE))
        if direction.Magnitude < 0.01 then return end
        local cross = myRoot.CFrame.LookVector:Cross(direction.Unit)
        local angle = math.asin(math.clamp(cross.Magnitude, -1, 1))
        myRoot.AssemblyAngularVelocity = cross.Magnitude > 0.01
            and cross.Unit * angle * 80
            or Vector3.zero
    end

    local function bv2UpdatePing()
        LPH_ATTRIBUTES(VM(NONE))
        local ok, ping = pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(ping) == "number" then
            BypasV2.realPingMs = math.floor(ping)
        end
        BypasV2.currentPing = math.clamp(
            BypasV2.realPingMs / 1000,
            BV2CFG.MIN_PING_COMPENSATION,
            BV2CFG.MAX_PING_COMPENSATION
        )
    end

    local function bv2Swing()
        LPH_ATTRIBUTES(VM(NONE))
        local now = tick()
        if autoSwingEnabled == false or BypasV2.swingLocked or now < BypasV2.nextSwingAt then return end
        BypasV2.swingLocked = true
        BypasV2.nextSwingAt = now + BV2CFG.SWING_COOLDOWN
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            local char = LP.Character
            if not char then return end
            local bat = nanzGetBat()
            if not bat then return end
            if bat.Parent ~= char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:EquipTool(bat) end
            end
            bat:Activate()
            local remote = bat:FindFirstChildWhichIsA("RemoteEvent")
            if remote then remote:FireServer() end
        end)
        task.delay(BV2CFG.SWING_COOLDOWN, function()
            BypasV2.swingLocked = false
        end)
    end

    local function bv2Loop(dt)
        LPH_ATTRIBUTES(VM(NONE))
        if not BypasV2.enabled then return end
        local char = LP.Character
        if not char then return end
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        local myHum = char:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then return end
        myHum.AutoRotate = false

        local equippedTool = char:FindFirstChildOfClass("Tool")
        if not equippedTool then
            local bat = nanzGetBat()
            if bat and bat.Parent ~= char then
                pcall(function() myHum:EquipTool(bat) end)
            end
        end

        local target, dist = bv2FindNearest(myRoot)
        if not target or not target.Character then
            bv2Reset()
            return
        end
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
        if not targetRoot or not targetHum or targetHum.Health <= 0 then
            bv2Reset()
            return
        end

        if BypasV2.targetPlayer ~= target then bv2Reset() end
        BypasV2.targetPlayer = target

        bv2UpdatePing()

        local targetPos = targetRoot.Position
        local dt_clamped = math.max(dt, 1/240)

        if BypasV2.lastTargetPos then
            local instantVel = (targetPos - BypasV2.lastTargetPos) / dt_clamped
            local accel = instantVel - BypasV2.targetVelocity
            if accel.Magnitude > BV2CFG.MAX_VELOCITY_CHANGE then
                instantVel = BypasV2.targetVelocity + accel.Unit * BV2CFG.MAX_VELOCITY_CHANGE
            end
            local horizontalVel = Vector3.new(instantVel.X, 0, instantVel.Z)
            if horizontalVel.Magnitude > BV2CFG.MAX_HORIZONTAL_VELOCITY then
                horizontalVel = horizontalVel.Unit * BV2CFG.MAX_HORIZONTAL_VELOCITY
                instantVel = Vector3.new(horizontalVel.X, instantVel.Y, horizontalVel.Z)
            end
            table.insert(BypasV2.accelerationHistory, (instantVel - BypasV2.targetVelocity) / dt_clamped)
            if #BypasV2.accelerationHistory > 4 then table.remove(BypasV2.accelerationHistory, 1) end
            table.insert(BypasV2.velocityHistory, instantVel)
            if #BypasV2.velocityHistory > 8 then table.remove(BypasV2.velocityHistory, 1) end
            table.insert(BypasV2.verticalVelocityHistory, instantVel.Y)
            if #BypasV2.verticalVelocityHistory > 5 then table.remove(BypasV2.verticalVelocityHistory, 1) end
            BypasV2.targetVelocity = instantVel
            BypasV2.smoothedVelocity = BypasV2.smoothedVelocity:Lerp(instantVel, BV2CFG.VELOCITY_SMOOTHING)
        end
        BypasV2.lastTargetPos = targetPos

        local ax = NanzV3.AX
        local nowT = tick()
        if ax.track(targetRoot, nowT) and (targetPos - myRoot.Position).Magnitude <= 300 then
            ax.snapUntil = nowT + 0.2
        end
        if nowT < ax.snapUntil then
            ax.snap(myRoot, targetRoot)
            bv2Swing()
            return
        end
        local tv = ax.vel
        local lead = math.clamp(BypasV2.currentPing + BV2CFG.SERVER_TICKRATE + 0.05, 0.08, 0.3)
        local predictedPos = targetPos + Vector3.new(tv.X, 0, tv.Z) * lead
        bv2FaceTarget(myRoot, predictedPos - myRoot.Position)
        if (targetPos - myRoot.Position).Magnitude <= BV2CFG.ACTIVATE_DISTANCE then
            if tick() - BypasV2.lastActivationTime >= 0.3 then
                bv2Swing()
                BypasV2.lastActivationTime = tick()
            end
        end
        local settings = JoxAimbotSettings or {}
        ax.chase(myRoot, targetRoot, predictedPos, NanzV3.cap(settings.bypassSpeed, NanzV3.SPD.V2), BV2CFG.MIN_FOLLOW_DISTANCE)
    end

    local function bv2Start()
        LPH_ATTRIBUTES(VM(NONE))
        if BypasV2.enabled then return end
        BypasV2.enabled = true
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                BypasV2.previousHumanoid = hum
                BypasV2.previousAutoRotate = hum.AutoRotate
                hum.AutoRotate = false
            end
        end
        bv2Reset()
        BypasV2.lastActivationTime = 0
        BypasV2.conn = RunService.RenderStepped:Connect(function(dt)
            pcall(bv2Loop, dt)
        end)
    end

    local function bv2Stop()
        LPH_ATTRIBUTES(VM(NONE))
        if not BypasV2.enabled then return end
        BypasV2.enabled = false
        if BypasV2.conn then
            BypasV2.conn:Disconnect()
            BypasV2.conn = nil
        end
        local char = LP.Character
        if char then
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            if myRoot then
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end
            local previous = BypasV2.previousHumanoid
            local hum = char:FindFirstChildOfClass("Humanoid")
            if previous and previous.Parent then
                previous.AutoRotate = true
            elseif hum then hum.AutoRotate = true end
        end
        BypasV2.previousHumanoid = nil
        BypasV2.previousAutoRotate = nil
        bv2Reset()
    end
    table.insert(_G.__NanzCleanupFns, function() bv2Stop() end)

    -- dispatcher used by the Jox "Bypass Aimbot" control
    nanzStartBy = function()
        LPH_ATTRIBUTES(VM(NONE))
        if AIMBOT_BYPAS_VERSION == "V2" then
            if BypasV2.enabled then return true end
            pcall(nanzV3Stop) -- make sure V1 is off
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                if joxBatAimbotEnabled then stopJoxBatAimbot() end
                if autoLeftEnabled then stopAutoLeft() end
                if autoRightEnabled then stopAutoRight() end
            end)
            nanzFreezeInput(true) -- player can't walk; the aimbot chases
            bv2Start()
            return true
        else
            if BypasV2.enabled then bv2Stop() end
            return nanzV3Start()
        end
    end

    nanzStopBy = function()
        LPH_ATTRIBUTES(VM(NONE))
        if BypasV2.enabled then bv2Stop() end
        nanzV3Stop()
        nanzFreezeInput(joxBatAimbotEnabled == true)
    end

    -- switch Bypas V1 <-> V2 (restarts the engine if it is running)
    setAimbotBypasVersion = function(ver)
        LPH_ATTRIBUTES(VM(NONE))
        ver = (ver == "V2") and "V2" or "V1"
        local wasOn = aimbotV2Enabled == true
        if wasOn then nanzStopBy() end
        AIMBOT_BYPAS_VERSION = ver
        if wasOn then nanzStartBy() end
    end
end

-- ------------------------------------------------------------
-- AIMBOT: FR HUB V8-style Normal + NANZ Anti Bypass
-- mode, sticky target lock, fly-to-target chase, auto swing.
-- ------------------------------------------------------------
AIMBOT_VERSION = "V1"
AIMBOT_MODE = "Anti Bypass"
setAimbotMode = nil
setAimbotVersion = nil

do
    local AV = {
        on = false, conn = nil, charConn = nil, target = nil, lastScan = 0,
        stickyTarget = nil, stickyUntil = 0, prevAutoRotate = nil, swingCd = false,
    }
    local AV_STICKY_TIME, AV_STICKY_MAX_DIST = 1.8, 130

    local function avIsLagger()
        LPH_ATTRIBUTES(VM(NONE))
        return laggerModeEnabled == true or laggerCarryActive == true
    end
    local function avCurSpeed()
        LPH_ATTRIBUTES(VM(NONE))
        local settings = JoxAimbotSettings or {}
        if avIsLagger() then
            return tonumber(settings.normalLaggerSpeed) or 40
        end
        return tonumber(settings.normalSpeed) or tonumber(aimbotSpeedValue) or 58
    end
    local function avClosest()
        LPH_ATTRIBUTES(VM(NONE))
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not root then return nil, math.huge end
        local best, minDist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and hum and hum.Health > 0 then
                    local dv = tRoot.Position - root.Position
                    local d = math.sqrt(dv.X*dv.X + dv.Z*dv.Z) + math.abs(dv.Y) * 0.2
                    if d < minDist then minDist, best = d, tRoot end
                end
            end
        end
        return best, minDist
    end
    local function avStickyValid(root, tRoot)
        LPH_ATTRIBUTES(VM(NONE))
        if not tRoot or not tRoot.Parent or not root then return false end
        local hum = tRoot.Parent:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local dv = tRoot.Position - root.Position
        return math.sqrt(dv.X*dv.X + dv.Z*dv.Z) <= AV_STICKY_MAX_DIST
    end
    local function avGetTarget()
        LPH_ATTRIBUTES(VM(NONE))
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local now = tick()
        if AV.stickyTarget and now < AV.stickyUntil and avStickyValid(root, AV.stickyTarget) then
            AV.target = AV.stickyTarget
            return AV.stickyTarget
        end
        if now - AV.lastScan <= 0.08 and AV.target and avStickyValid(root, AV.target) then
            return AV.target
        end
        AV.lastScan = now
        local c = avClosest()
        AV.target, AV.stickyTarget, AV.stickyUntil = c, c, now + AV_STICKY_TIME
        return c
    end

    local function avStop()
        LPH_ATTRIBUTES(VM(NONE))
        AV.on = false
        if AV.conn then pcall(function() AV.conn:Disconnect() end); AV.conn = nil end
        if AV.charConn then pcall(function() AV.charConn:Disconnect() end); AV.charConn = nil end
        AV.target, AV.stickyTarget, AV.stickyUntil, AV.swingCd = nil, nil, 0, false
        nanzResetMotion()
        AV.prevAutoRotate = nil
    end
    table.insert(_G.__NanzCleanupFns, function() avStop() end)

    -- (JOX75) Anti TP-Down / hold-jump helpers. Kept on the AV table so the
    -- main chunk's local count does not grow.
    AV.T = {root=nil, pos=nil, t=0, vel=Vector3.zero, snapUntil=0, ground=nil, groundT=0}
    AV.HIGH = 11
    AV.groundY = function(tRoot)
        local T, now = AV.T, tick()
        if T.ground and now - T.groundT < 0.12 then return T.ground end
        local gy = nil
        pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            local list = {}
            for _, p in ipairs(Players:GetPlayers()) do if p.Character then list[#list+1] = p.Character end end
            params.FilterDescendantsInstances = list
            local res = workspace:Raycast(tRoot.Position, Vector3.new(0, -400, 0), params)
            if res then gy = res.Position.Y end
        end)
        T.ground, T.groundT = gy, now
        return gy
    end
    -- position-based velocity (immune to the huge fake velocities anti-bat users replicate)
    -- returns true when the target just teleported (TP down / TP to base)
    AV.track = function(tRoot, now)
        local T, pos = AV.T, tRoot.Position
        local teleported = false
        if T.root ~= tRoot then
            T.root, T.pos, T.t, T.vel, T.snapUntil, T.ground = tRoot, pos, now, Vector3.zero, 0, nil
            T.prevVel, T.acc = Vector3.zero, Vector3.zero
        else
            local dt = math.max(now - T.t, 1/240)
            local disp = pos - T.pos
            local flatD = Vector3.new(disp.X, 0, disp.Z)
            -- TP down / base TP / lag blink: tighter thresholds so we catch fast ground drops
            local isTP = (disp.Y < -6 and flatD.Magnitude < 22)
                or (math.abs(disp.Y) > 10 and flatD.Magnitude < 18)
                or flatD.Magnitude > 55
            if isTP and now - (T.lastSnap or 0) > 0.35 then
                teleported = true
                T.lastSnap = now
                T.vel = Vector3.zero
                T.prevVel, T.acc = Vector3.zero, Vector3.zero
            else
                local v = flatD / dt
                if dt > 0.12 then v = Vector3.zero end
                -- allow higher measured speed for ping-lagger targets (cap soft)
                if v.Magnitude > 160 then v = v.Unit * 160 end
                local prev = T.prevVel or Vector3.zero
                T.acc = (v - prev) / math.max(dt, 1/120)
                if T.acc.Magnitude > 400 then T.acc = T.acc.Unit * 400 end
                T.prevVel = v
                T.vel = T.vel:Lerp(v, 0.55)
            end
            T.pos, T.t = pos, now
        end
        return teleported
    end

    -- FR HUB V8-style Normal aimbot (replaces weak Normal)
    local function avNormalStep()
        LPH_ATTRIBUTES(VM(NONE))
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root then return end
        if hum.Health <= 0 then return end
        if hum.PlatformStand then pcall(function() hum.PlatformStand = false end) end
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            local lv, av = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
            if lv.Magnitude > 220 then root.AssemblyLinearVelocity = lv.Unit * 60 end
            if av.Magnitude > 25 then root.AssemblyAngularVelocity = Vector3.zero end
        end)

        -- equip bat
        local bat = char:FindFirstChildOfClass("Tool")
        if not bat then
            bat = nanzFindBat and nanzFindBat() or nil
            if bat then pcall(function() hum:EquipTool(bat) end) end
        end

        local target = avGetTarget()
        if not target then
            hum.AutoRotate = true
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(Vector3.zero, 0.35)
            return
        end
        AV.target = target
        hum.AutoRotate = false

        local myPos = root.Position
        local targetPos = target.Position
        local targetVel = target.AssemblyLinearVelocity or Vector3.zero

        -- snap on big TP
        local now = tick()
        local T = AV.T
        if AV.track and AV.track(target, now) and (targetPos - myPos).Magnitude <= 300 then
            T.snapUntil = now + 0.18
        end
        if now < (T.snapUntil or 0) then
            local back = Vector3.new(myPos.X - targetPos.X, 0, myPos.Z - targetPos.Z)
            if back.Magnitude < 0.5 then
                local lv = target.CFrame.LookVector
                back = Vector3.new(-lv.X, 0, -lv.Z)
            end
            back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
            local stand = targetPos + back * 3.5
            pcall(function()
                root.CFrame = root.CFrame:Lerp(CFrame.new(stand, Vector3.new(targetPos.X, stand.Y, targetPos.Z)), 0.28)
                root.AssemblyLinearVelocity = Vector3.new(targetVel.X, 0, targetVel.Z)
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            if autoSwingEnabled ~= false then
                local b = char:FindFirstChildOfClass("Tool")
                if b then pcall(function() b:Activate() end) end
            end
            return
        end

        -- FR HUB V8 prediction + smooth velocity chase
        local predictPos = targetPos + targetVel * 0.14 + target.CFrame.LookVector * 0.3
        local direction = predictPos - myPos
        if direction.Magnitude < 0.01 then return end
        local flatDir = Vector3.new(direction.X, 0, direction.Z)
        if flatDir.Magnitude < 0.01 then
            flatDir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
        end
        if flatDir.Magnitude < 0.01 then return end
        flatDir = flatDir.Unit

        local settings = JoxAimbotSettings or {}
        local speed = tonumber(settings.normalSpeed) or tonumber(aimbotSpeedValue) or 58
        if type(NanzV3) == "table" and NanzV3.cap then
            speed = NanzV3.cap(speed, (NanzV3.SPD and NanzV3.SPD.V1) or 75)
        end

        local yVel = (targetPos.Y + 3.7 - myPos.Y) * 19.5 + targetVel.Y * 0.8
        if hum.FloorMaterial ~= Enum.Material.Air then yVel = math.max(yVel, 13) end
        -- jump up if target is clearly above
        local dy = targetPos.Y - myPos.Y
        if dy > 2 then
            yVel = math.max(yVel, math.clamp(dy * 24, 40, 105))
            pcall(function()
                hum.Jump = true
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
        yVel = math.clamp(yVel, -70, 110)

        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(
            Vector3.new(flatDir.X * speed, yVel, flatDir.Z * speed), 0.8)

        local predictedPos = targetPos + targetVel * math.clamp(targetVel.Magnitude / 150, 0.05, 0.2)
        local toPredict = predictedPos - myPos
        if toPredict.Magnitude > 0.1 then
            local diffCF = root.CFrame:Inverse() * CFrame.lookAt(myPos, predictedPos)
            local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
            root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(
                Vector3.new(math.clamp(rx, -2.5, 2.5) * 42, math.clamp(ry, -2.5, 2.5) * 42, math.clamp(rz, -2.5, 2.5) * 42))
        else
            root.AssemblyAngularVelocity = Vector3.zero
        end

        if flatDir.Magnitude > 0.1 then
            pcall(function() hum:Move(flatDir, false) end)
        end

        -- auto swing when close
        if autoSwingEnabled ~= false and (root.Position - target.Position).Magnitude <= 8 then
            local b = char:FindFirstChildOfClass("Tool") or bat
            if b and b:IsA("Tool") then
                pcall(function() b:Activate() end)
            end
        end
    end

    -- FR HUB V9-style Aimbot V2 aimbot (extra sticky + tighter swing)
    local function avInputV2Step()
        LPH_ATTRIBUTES(VM(NONE))
