FpsBoostData=FpsBoostData or {State={},Queue={},Processing=false,Active=false,Connection=nil,Watchdog=nil}
-- BOOST FPS V2: smooth max frames without nuking game visuals.
-- Keeps essential graphics, strips only non-critical render cost,
-- stabilizes frame time for solid movement and solid play.
FpsBoost=function(Toggle)
    LPH_ATTRIBUTES(VM(NONE))
    pcall(function()
        LPH_ATTRIBUTES(VM(NONE))
        local function isPlayerModel(model)
            return model and Players:GetPlayerFromCharacter(model) ~= nil
        end

        local function SaveState()
            LPH_ATTRIBUTES(VM(NONE))
            if FpsBoostData.State.Saved then return end
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                local okQ, ql = pcall(function() return settings().Rendering.QualityLevel end)
                FpsBoostData.State.QualityLevel = okQ and ql or nil
                FpsBoostData.State.Lighting = {
                    GlobalShadows = Lighting.GlobalShadows,
                    FogEnd = Lighting.FogEnd,
                    FogStart = Lighting.FogStart,
                    EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
                    EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
                    Brightness = Lighting.Brightness,
                }
                FpsBoostData.State.EffectEnabled = {}
                for _, v in pairs(Lighting:GetChildren()) do
                    pcall(function()
                        LPH_ATTRIBUTES(VM(NONE))
                        if v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect")
                            or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
                            FpsBoostData.State.EffectEnabled[v] = v.Enabled
                        end
                    end)
                end
                FpsBoostData.State.Parts = {}
                FpsBoostData.State.Saved = true
            end)
        end

        local function SoftOptimize(obj)
            LPH_ATTRIBUTES(VM(NONE))
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                if not obj or not obj.Parent then return end
                local model = obj:FindFirstAncestorOfClass("Model")
                local playerOwned = isPlayerModel(model)

                -- Keep player characters intact for solid combat feel.
                if playerOwned then
                    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        if obj.Enabled then
                            FpsBoostData.State.Parts[obj] = FpsBoostData.State.Parts[obj] or {}
                            if FpsBoostData.State.Parts[obj].Enabled == nil then
                                FpsBoostData.State.Parts[obj].Enabled = true
                            end
                            obj.Enabled = false
                        end
                    end
                    return
                end

                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    if obj.Enabled ~= false then
                        FpsBoostData.State.Parts[obj] = FpsBoostData.State.Parts[obj] or {}
                        if FpsBoostData.State.Parts[obj].Enabled == nil then
                            FpsBoostData.State.Parts[obj].Enabled = obj.Enabled
                        end
                        obj.Enabled = false
                    end
                elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                    if obj.Enabled then
                        FpsBoostData.State.Parts[obj] = FpsBoostData.State.Parts[obj] or {}
                        if FpsBoostData.State.Parts[obj].Enabled == nil then
                            FpsBoostData.State.Parts[obj].Enabled = true
                        end
                        -- Dim, do not fully kill local readability.
                        if obj.Brightness and obj.Brightness > 0.35 then
                            if FpsBoostData.State.Parts[obj].Brightness == nil then
                                FpsBoostData.State.Parts[obj].Brightness = obj.Brightness
                            end
                            obj.Brightness = math.min(obj.Brightness, 0.35)
                        end
                    end
                elseif obj:IsA("BasePart") then
                    local st = FpsBoostData.State.Parts[obj]
                    if not st then
                        st = {
                            CastShadow = obj.CastShadow,
                            Reflectance = obj.Reflectance,
                        }
                        FpsBoostData.State.Parts[obj] = st
                    end
                    if obj.CastShadow then obj.CastShadow = false end
                    if obj.Reflectance and obj.Reflectance > 0.05 then
                        obj.Reflectance = 0
                    end
                    -- Keep materials; only soft-trim expensive reflectance/shadows.
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    -- Leave essential map textures; only mute heavy animated overlays if marked.
                    if obj.Transparency and obj.Transparency < 0.2 and (obj.Name:lower():find("fx") or obj.Name:lower():find("glow") or obj.Name:lower():find("spark")) then
                        FpsBoostData.State.Parts[obj] = FpsBoostData.State.Parts[obj] or {}
                        if FpsBoostData.State.Parts[obj].Transparency == nil then
                            FpsBoostData.State.Parts[obj].Transparency = obj.Transparency
                        end
                        obj.Transparency = 1
                    end
                elseif obj:IsA("Animator") then
                    -- Stop non-player ambient animation spam only.
                    if not playerOwned then
                        for _, track in pairs(obj:GetPlayingAnimationTracks()) do
                            pcall(function() track:Stop(0) end)
                        end
                    end
                end
            end)
        end

        local function ApplyLightingBoost()
            LPH_ATTRIBUTES(VM(NONE))
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                -- Soft lighting pass: still readable, lower GPU cost.
                Lighting.GlobalShadows = false
                if Lighting.FogEnd < 1e5 then
                    Lighting.FogStart = 0
                    Lighting.FogEnd = 1e6
                end
                Lighting.EnvironmentDiffuseScale = math.min(Lighting.EnvironmentDiffuseScale or 0, 0.25)
                Lighting.EnvironmentSpecularScale = math.min(Lighting.EnvironmentSpecularScale or 0, 0.15)
                for _, v in pairs(Lighting:GetChildren()) do
                    pcall(function()
                        LPH_ATTRIBUTES(VM(NONE))
                        if v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
                            v.Enabled = false
                        elseif v:IsA("ColorCorrectionEffect") then
                            -- Keep mild color correction for look, disable heavy ones only if extreme.
                            if (v.Saturation and math.abs(v.Saturation) > 0.35) or (v.Contrast and math.abs(v.Contrast) > 0.35) then
                                v.Enabled = false
                            end
                        end
                    end)
                end
                pcall(function()
                    LPH_ATTRIBUTES(VM(NONE))
                    -- Push highest stable quality the client can hold; engine will clamp.
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
                end)
            end)
        end

        local function EnableSync()
            LPH_ATTRIBUTES(VM(NONE))
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                -- Mutual exclusivity with basic BOOST FPS
                if FpsBoostBasicData and FpsBoostBasicData.Active and FpsBoostBasic then
                    pcall(function() FpsBoostBasic(false) end)
                    fpsBoostEnabled = false
                    if setFpsBoostBasicVisual then pcall(setFpsBoostBasicVisual, false) end
                    if setVisual then pcall(setVisual, "FpsBoostBasic", false) end
                end
                SaveState()
                ApplyLightingBoost()

                local descendants = workspace:GetDescendants()
                local batch = 120
                for i = 1, #descendants, batch do
                    local limit = math.min(i + batch - 1, #descendants)
                    for idx = i, limit do
                        SoftOptimize(descendants[idx])
                    end
                    if limit < #descendants then task.wait() end
                end

                if FpsBoostData.Connection then
                    pcall(function() FpsBoostData.Connection:Disconnect() end)
                    FpsBoostData.Connection = nil
                end
                FpsBoostData.Connection = workspace.DescendantAdded:Connect(function(obj)
                    LPH_ATTRIBUTES(VM(NONE))
                    if FpsBoostData.Active then SoftOptimize(obj) end
                end)

                if FpsBoostData.Watchdog then
                    pcall(function() FpsBoostData.Watchdog:Disconnect() end)
                    FpsBoostData.Watchdog = nil
                end
                -- Re-assert soft lighting every few seconds so game scripts cannot undo smoothness.
                FpsBoostData.Watchdog = RunService.Heartbeat:Connect(function()
                    LPH_ATTRIBUTES(VM(NONE))
                    if not FpsBoostData.Active then return end
                    if (FpsBoostData._lastWatch or 0) + 2 > tick() then return end
                    FpsBoostData._lastWatch = tick()
                    ApplyLightingBoost()
                end)

                FpsBoostData.Active = true
            end)
        end

        local function DisableSync()
            LPH_ATTRIBUTES(VM(NONE))
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                if FpsBoostData.Connection then
                    pcall(function() FpsBoostData.Connection:Disconnect() end)
                    FpsBoostData.Connection = nil
                end
                if FpsBoostData.Watchdog then
                    pcall(function() FpsBoostData.Watchdog:Disconnect() end)
                    FpsBoostData.Watchdog = nil
                end
                if not FpsBoostData.State.Saved then
                    FpsBoostData.Active = false
                    return
                end

                local L = FpsBoostData.State.Lighting or {}
                pcall(function()
                    LPH_ATTRIBUTES(VM(NONE))
                    if L.GlobalShadows ~= nil then Lighting.GlobalShadows = L.GlobalShadows end
                    if L.FogEnd ~= nil then Lighting.FogEnd = L.FogEnd end
                    if L.FogStart ~= nil then Lighting.FogStart = L.FogStart end
                    if L.EnvironmentDiffuseScale ~= nil then Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale end
                    if L.EnvironmentSpecularScale ~= nil then Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale end
                    if L.Brightness ~= nil then Lighting.Brightness = L.Brightness end
                end)

                for effect, wasEnabled in pairs(FpsBoostData.State.EffectEnabled or {}) do
                    pcall(function()
                        if effect and effect.Parent and wasEnabled ~= nil then
                            effect.Enabled = wasEnabled
                        end
                    end)
                end

                if FpsBoostData.State.QualityLevel ~= nil then
                    pcall(function() settings().Rendering.QualityLevel = FpsBoostData.State.QualityLevel end)
                end

                local parts = {}
                for obj, props in pairs(FpsBoostData.State.Parts or {}) do
                    parts[#parts + 1] = {obj = obj, props = props}
                end
                local batch = 120
                for i = 1, #parts, batch do
                    local limit = math.min(i + batch - 1, #parts)
                    for idx = i, limit do
                        local entry = parts[idx]
                        pcall(function()
                            LPH_ATTRIBUTES(VM(NONE))
                            local obj, props = entry.obj, entry.props
                            if obj and obj.Parent and props then
                                if props.CastShadow ~= nil then obj.CastShadow = props.CastShadow end
                                if props.Reflectance ~= nil then obj.Reflectance = props.Reflectance end
                                if props.Enabled ~= nil then obj.Enabled = props.Enabled end
                                if props.Brightness ~= nil then obj.Brightness = props.Brightness end
                                if props.Transparency ~= nil then obj.Transparency = props.Transparency end
                                if props.TextureID ~= nil then obj.TextureID = props.TextureID end
                                if props.Material ~= nil then obj.Material = props.Material end
                            end
                        end)
                    end
                    if limit < #parts then task.wait() end
                end

                FpsBoostData.State = {}
                FpsBoostData.Active = false
            end)
        end

        if Toggle == nil then Toggle = not FpsBoostData.Active end

        FpsBoostData.Queue = FpsBoostData.Queue or {}
        table.insert(FpsBoostData.Queue, Toggle)

        if FpsBoostData.Processing then return end
        FpsBoostData.Processing = true

        task.spawn(function()
            LPH_ATTRIBUTES(VM(NONE))
            while #FpsBoostData.Queue > 0 do
                local nextToggle = table.remove(FpsBoostData.Queue, 1)
                while #FpsBoostData.Queue > 0 do
                    local peeked = FpsBoostData.Queue[#FpsBoostData.Queue]
                    if peeked ~= nextToggle then
                        nextToggle = table.remove(FpsBoostData.Queue, #FpsBoostData.Queue)
                        FpsBoostData.Queue = {}
                    else
                        table.remove(FpsBoostData.Queue, #FpsBoostData.Queue)
                    end
                end
                if nextToggle and not FpsBoostData.Active then
                    EnableSync()
                elseif not nextToggle and FpsBoostData.Active then
                    DisableSync()
                end
            end
            FpsBoostData.Processing = false
        end)
    end)
end

