-- 1) Echo Predict: second-order lead (pos + vel + accel) instead of dumb linear aim
_G.echoPredictEnabled = false
_G.EchoPredict = _G.EchoPredict or {enabled=false, conn=nil, hist={}}
function _G.EchoPredict.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.echoPredictEnabled = true
    _G.EchoPredict.enabled = true
    _G.EchoPredict.hist = {}
    if _G.EchoPredict.conn then pcall(function() _G.EchoPredict.conn:Disconnect() end) end
    _G.EchoPredict.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.EchoPredict.enabled then return end
        if not (joxBatAimbotEnabled or aimbotV2Enabled) then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end
        local my = root.Position
        local best, bd = nil, 55
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local d = (tr.Position - my).Magnitude
                    if d < bd then bd, best = d, {plr=plr, root=tr} end
                end
            end
        end
        if not best then return end
        local id = best.plr.UserId
        local pos = best.root.Position
        local now = tick()
        local h = _G.EchoPredict.hist[id]
        if not h then
            _G.EchoPredict.hist[id] = {pos=pos, t=now, vel=Vector3.zero, acc=Vector3.zero}
            return
        end
        local dt = math.clamp(now - h.t, 1/240, 0.12)
        local rawV = (pos - h.pos) / dt
        local flatV = Vector3.new(rawV.X, rawV.Y, rawV.Z)
        if flatV.Magnitude > 180 then flatV = flatV.Unit * 180 end
        local acc = (flatV - h.vel) / dt
        if acc.Magnitude > 500 then acc = acc.Unit * 500 end
        h.pos, h.t, h.vel, h.acc = pos, now, h.vel:Lerp(flatV, 0.5), h.acc:Lerp(acc, 0.35)
        -- predict 90–140ms ahead with 1/2 a t^2
        local lead = 0.11
        local pred = pos + h.vel * lead + h.acc * (0.5 * lead * lead)
        local to = pred - my
        local flat = Vector3.new(to.X, 0, to.Z)
        if flat.Magnitude < 0.15 then return end
        local dir = flat.Unit
        local v = root.AssemblyLinearVelocity
        -- blend only 18%: steer aimbot path toward 2nd-order point without takeover
        root.AssemblyLinearVelocity = Vector3.new(
            v.X + (dir.X * math.min(bd * 2.2, 40) - v.X) * 0.18,
            v.Y + ((pred.Y - my.Y) * 12 - v.Y) * 0.1,
            v.Z + (dir.Z * math.min(bd * 2.2, 40) - v.Z) * 0.18
        )
    end)
end
function _G.EchoPredict.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.echoPredictEnabled = false
    _G.EchoPredict.enabled = false
    if _G.EchoPredict.conn then pcall(function() _G.EchoPredict.conn:Disconnect() end); _G.EchoPredict.conn=nil end
end

