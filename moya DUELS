-- Anti Back Lag V3: stronger anti-rubberband (still no game metatable)
_G.antiBackLagV3Enabled = false
_G.MoyaAntiBackLagV3 = _G.MoyaAntiBackLagV3 or {
    enabled = false,
    conn = nil,
    conn2 = nil,
    lastGood = nil,
    want = Vector3.new(0, 0, 1),
    lastWantT = 0,
