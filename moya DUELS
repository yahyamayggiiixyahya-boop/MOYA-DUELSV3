local function getKeyName(kc)
    local name = tostring(kc):gsub("Enum.KeyCode.","")
    local map = {LeftControl="LCTRL",RightControl="RCTRL",LeftShift="LSHIFT",RightShift="RSHIFT",
        LeftAlt="LALT",RightAlt="RALT",ButtonA="A",ButtonB="B",ButtonX="X",ButtonY="Y",
        ButtonL1="LB",ButtonR1="RB",ButtonL2="LT",ButtonR2="RT",ButtonStart="START",
        ButtonSelect="SELECT",LeftThumbstick="L3",RightThumbstick="R3",
        DirectionalPadUp="DPAD U",DirectionalPadDown="DPAD D",DirectionalPadLeft="DPAD L",DirectionalPadRight="DPAD R"}
    if map[name] then return map[name] end
    if #name > 6 then name=name:sub(1,6) end
    return name:upper()
end

