-- 5) Latency Ghost: blend live enemy pos with delayed ghost scaled by crude ping estimate
_G.latencyGhostEnabled = false
_G.LatencyGhost = _G.LatencyGhost or {enabled=false, conn=nil, buf={}}
function _G.LatencyGhost.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.latencyGhostEnabled = true
    _G.LatencyGhost.enabled = true
    _G.LatencyGhost.buf = {}
    if _G.LatencyGhost.conn then pcall(function() _G.LatencyGhost.conn:Disconnect() end) end
    _G.LatencyGhost.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.LatencyGhost.enabled then return end
        if not (joxBatAimbotEnabled or aimbotV2Enabled) then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local now = tick()
        -- estimate ping from Stats if available
        local pingMs = 60
        pcall(function()
            local s = game:GetService("Stats")
            local n = s.Network
            local item = n:FindFirstChild("ServerStatsItem") or n:FindFirstChild("ServerStats")
            -- fallback: Player:GetNetworkPing
            if LP.GetNetworkPing then
                pingMs = math.clamp(LP:GetNetworkPing() * 1000, 20, 200)
            end
        end)
        local delay = math.clamp(pingMs / 1000 * 0.85, 0.04, 0.18)
        local my = root.Position
        local best, bd = nil, 50
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local id = plr.UserId
                    local buf = _G.LatencyGhost.buf[id]
                    if not buf then buf = {}; _G.LatencyGhost.buf[id] = buf end
                    buf[#buf+1] = {t=now, p=tr.Position}
                    while #buf > 0 and now - buf[1].t > 0.35 do table.remove(buf, 1) end
                    local d = (tr.Position - my).Magnitude
                    if d < bd then bd, best = d, {tr=tr, buf=buf, live=tr.Position} end
                end
            end
        end
        if not best or not best.buf or #best.buf < 2 then return end
        local ghost = best.live
        local targetT = now - delay
        for i = #best.buf, 2, -1 do
            local a, b = best.buf[i-1], best.buf[i]
            if a.t <= targetT and b.t >= targetT then
                local apha = (targetT - a.t) / math.max(b.t - a.t, 1e-3)
                ghost = a.p:Lerp(b.p, apha)
                break
            end
        end
        -- aim blend: mostly live, partially where they "were" on your delay
        local blend = best.live:Lerp(ghost, 0.35)
        local flat = Vector3.new(blend.X - my.X, 0, blend.Z - my.Z)
        if flat.Magnitude < 0.2 then return end
        local dir = flat.Unit
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(
            v.X + (dir.X * 28 - v.X) * 0.12,
            v.Y,
            v.Z + (dir.Z * 28 - v.Z) * 0.12
        )
    end)
end
