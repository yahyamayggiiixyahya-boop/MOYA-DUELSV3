local function _moyaClassicAntiBatPulse(rangeMul)
    -- Throttled classic anti-bat: soft amplify + exact restore (anti-glitch)
    local now = tick()
    if now - (_G._moyaAbPulseT or 0) < 0.032 then return end
    _G._moyaAbPulseT = now
    local char=LP.Character; if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health<=0 then return end
    if hrp.Position.Y < -10 then return end
    local vel=hrp.Velocity
    local asm=hrp.AssemblyLinearVelocity
    -- already glitching hard? skip pulse this frame
    if Vector3.new(vel.X,0,vel.Z).Magnitude > 140 then
        hrp.Velocity = Vector3.new(math.clamp(vel.X,-55,55), math.clamp(vel.Y,-50,40), math.clamp(vel.Z,-55,55))
        hrp.AssemblyLinearVelocity = Vector3.new(math.clamp(asm.X,-55,55), math.clamp(asm.Y,-50,40), math.clamp(asm.Z,-55,55))
        return
    end
    local md=hum.MoveDirection
    local y=math.clamp(vel.Y, -40, 32)
    local mul=math.clamp(rangeMul or 18, 8, 26)
    local fx, fz
    if md.Magnitude > 0.05 then
        local u=md.Unit
        local along = math.clamp(math.max(vel:Dot(Vector3.new(u.X,0,u.Z)), 6), 6, 28)
        fx = u.X * along * mul
        fz = u.Z * along * mul
    else
        return -- idle: do nothing (no jitter glitch)
    end
    -- hard cap fake sample so server never sees flash/rubberband speeds
    local cap = 95
    fx = math.clamp(fx, -cap, cap)
    fz = math.clamp(fz, -cap, cap)
    hrp.Velocity = Vector3.new(fx, y, fz)
    RunService.RenderStepped:Wait()
    if hrp and hrp.Parent then
        hrp.Velocity = vel
        hrp.AssemblyLinearVelocity = asm
    end
end

