-- ============================================================
-- Background Anti-Drop + Anti-Glitch (always-on, lightweight)
-- Keeps character stable: no random fall-through, no ragdoll stick,
-- clamps insane velocities from anti-bat / lag. Runs in background.
-- ============================================================
_G.MoyaAntiDrop = _G.MoyaAntiDrop or { enabled = true, conn = nil, lastSafe = nil, lastSafeT = 0 }
_G.MoyaSmoothGuard = _G.MoyaSmoothGuard or { enabled = true }

local function _moyaBgStabilize()
    LPH_ATTRIBUTES(VM(NONE))
    if _G.MoyaAntiDrop and _G.MoyaAntiDrop.enabled == false then return end
    pcall(function()
        local char = player and player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end

        -- anti platform-stand / ragdoll stick
        if hum.PlatformStand then hum.PlatformStand = false end
        pcall(function()
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)

        local v = root.AssemblyLinearVelocity
        local flat = Vector3.new(v.X, 0, v.Z)
        -- anti-glitch: clamp insane speeds (stops flash / map clip loops)
        if flat.Magnitude > 120 or math.abs(v.Y) > 160 then
            root.AssemblyLinearVelocity = Vector3.new(
                math.clamp(v.X, -70, 70),
                math.clamp(v.Y, -55, 55),
                math.clamp(v.Z, -70, 70)
            )
            root.Velocity = root.AssemblyLinearVelocity
        end
        if root.AssemblyAngularVelocity.Magnitude > 25 then
            root.AssemblyAngularVelocity = root.AssemblyAngularVelocity * 0.2
        end

        local pos = root.Position
        -- track safe grounded point
        local ray = RaycastParams.new()
        ray.FilterType = Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances = { char }
        local under = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), ray)
        if under and v.Y > -40 then
            _G.MoyaAntiDrop.lastSafe = Vector3.new(pos.X, under.Position.Y + (hum.HipHeight or 2) + 1.2, pos.Z)
            _G.MoyaAntiDrop.lastSafeT = tick()
        end

        -- anti-drop: sinking through floor / void edge
        local sinking = false
        if under then
            local standY = under.Position.Y + (hum.HipHeight or 2) + root.Size.Y * 0.5
            if pos.Y < standY - 2.5 and v.Y < -5 then
                sinking = true
                root.CFrame = CFrame.new(pos.X, standY + 0.15, pos.Z) * (root.CFrame - root.CFrame.Position)
                root.AssemblyLinearVelocity = Vector3.new(v.X * 0.5, 0, v.Z * 0.5)
            end
        elseif pos.Y < -15 then
            sinking = true
            local safe = _G.MoyaAntiDrop.lastSafe
            if safe and (_G.MoyaAntiDrop.lastSafeT or 0) + 25 > tick() then
                root.CFrame = CFrame.new(safe)
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)
end

if not _G._MoyaBgStabConn then
    _G.MoyaAntiDrop.enabled = true
    _G._MoyaBgStabConn = RunService.Heartbeat:Connect(function()
        -- cheap cadence: every other frame-ish via time gate
        local t = tick()
        if t - (_G._MoyaBgStabT or 0) < 0.05 then return end
        _G._MoyaBgStabT = t
        _moyaBgStabilize()
    end)
end

-- ============================================================
-- VOID ANTI DROP (background, silent — no GUI, no toggle needed)
-- Metatable velocity spoof: intercepts __index/__newindex on
-- HumanoidRootPart so the server never sees a falling velocity.
-- Runs automatically alongside MoyaAntiDrop for double coverage.
-- ============================================================
task.spawn(function()
    local _voidMt = pcall(getrawmetatable, game) and getrawmetatable(game) or nil
    if not _voidMt then return end -- executor doesn't support getrawmetatable, skip safely

    local _voidOldIdx    = nil
    local _voidOldNewIdx = nil
    local _voidSpoofed   = Vector3.zero
    local _voidActive    = false

    local function _voidStartAntiDrop()
        if _voidActive then return end
        _voidOldIdx    = _voidMt.__index
        _voidOldNewIdx = _voidMt.__newindex
        pcall(setreadonly, _voidMt, false)
        _voidMt.__index = newcclosure(function(self, key)
            if not checkcaller()
               and (key == "AssemblyLinearVelocity" or key == "Velocity")
               and typeof(self) == "Instance"
               and self:IsA("BasePart")
               and self.Name == "HumanoidRootPart" then
                local char = player and player.Character
                if char and self:IsDescendantOf(char) then
                    return _voidSpoofed
                end
            end
            return _voidOldIdx(self, key)
        end)
        _voidMt.__newindex = newcclosure(function(self, key, value)
            if not checkcaller()
               and (key == "AssemblyLinearVelocity" or key == "Velocity")
               and typeof(self) == "Instance"
               and self:IsA("BasePart")
               and self.Name == "HumanoidRootPart" then
                local char = player and player.Character
