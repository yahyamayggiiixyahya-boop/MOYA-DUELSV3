function M5.start()
    LPH_ATTRIBUTES(VM(NONE))
    if M5.conn then pcall(function() M5.conn:Disconnect() end) end
    M5.mem = M5.mem or {}
    local mem = M5.mem
    mem.samp = mem.samp or {}
    mem.path = mem.path or {}
    M5.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        local any = false
        for _, d in ipairs(M5.defs) do if M5.on[d.k] then any = true break end end
        if not any then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end
        local now = tick()
        local my = root.Position
        local v = root.AssemblyLinearVelocity
        local aimOn = joxBatAimbotEnabled or aimbotV2Enabled
        local excl = {}
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then excl[#excl+1]=p.Character end end

        -- sample enemies
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local id = plr.UserId
                    local s = mem.samp[id]
                    if not s then s = {hist={}, vel=Vector3.zero, acc=Vector3.zero}; mem.samp[id]=s end
                    local pos = tr.Position
                    s.hist[#s.hist+1] = {t=now, p=pos}
                    while #s.hist > 14 do table.remove(s.hist, 1) end
                    if #s.hist >= 3 then
                        local a, b = s.hist[#s.hist-2], s.hist[#s.hist]
                        local dt = math.max(b.t - a.t, 1/240)
                        local disp = b.p - a.p
                        local nv = disp / dt
                        if nv.Magnitude > 200 then nv = nv.Unit * 200 end
                        s.acc = (nv - s.vel) / dt
                        if s.acc.Magnitude > 600 then s.acc = s.acc.Unit * 600 end
                        s.vel = s.vel:Lerp(nv, 0.5)
                        local flat = Vector3.new(disp.X,0,disp.Z)
                        s.tpDown = (disp.Y < -6 and flat.Magnitude < 24) or (disp.Y/dt < -50 and flat.Magnitude < 18)
                        s.jerk = (s.prevAcc and (s.acc - s.prevAcc).Magnitude) or 0
                        s.prevAcc = s.acc
                        s.land = Vector3.new(b.p.X, m5Ray(b.p, excl) + 3.05, b.p.Z)
                        s.pos = pos
                    end
                end
            end
        end

        local tr, d, plr = m5Near(root, 48)
        local s = plr and mem.samp[plr.UserId]

        -- TPX family
        if tr and s then
            if s.tpDown and (now - (s.lastFire or 0) > 0.4) then
                s.lastFire = now
                local land = s.land or tr.Position
                if m5("PadPredict") and s.vel then
                    land = land + Vector3.new(s.vel.X,0,s.vel.Z)*0.08
                    land = Vector3.new(land.X, m5Ray(land, excl)+3.05, land.Z)
                end
                local back = Vector3.new(my.X-land.X,0,my.Z-land.Z)
                back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0,0,1)
                local side = Vector3.new(-back.Z,0,back.X)
                local stand = land + back * 3.3
                if m5("SidePrime") or m5("ShadowLand") then stand = stand + side * 1.25 end
                if m5("PreFall") or m5("ShadowLand") or m5("ImpactSeat") or m5("TwoStage") or m5("SpikeDrop") or m5("ClipDown") then
                    pcall(function()
                        root.CFrame = CFrame.new(stand, Vector3.new(land.X, stand.Y, land.Z))
                        local yv = -30
                        if m5("SpikeDrop") or m5("ClipDown") then yv = -70 end
                        if m5("FastSink") then yv = -90 end
                        root.AssemblyLinearVelocity = Vector3.new(s.vel.X*0.3, yv, s.vel.Z*0.3)
                    end)
                    mem.punish = now + (m5("AfterShock") and 0.34 or 0.22)
                    mem.focus = tr
                    if m5("TwoStage") then mem.stage2 = now + 0.12 end
                end
            end
            if m5("FloorMagnet") and s.pos and (s.pos.Y - my.Y) < -2 and d < 22 then
                local v2 = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v2.X, math.min(v2.Y, -45), v2.Z)
            end
            if m5("YBreak") and s.vel and s.vel.Y < -40 and d < 25 then
                local v2 = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v2.X, math.min(v2.Y, s.vel.Y*0.8), v2.Z)
            end
            if m5("NoFloat") and math.abs(root.AssemblyLinearVelocity.Y) < 3 and d < 10 and (tr.Position.Y - my.Y) < -1 then
                root.AssemblyLinearVelocity = Vector3.new(v.X, -25, v.Z)
            end
            if m5("SinkLine") and s.tpDown then
                local flat = Vector3.new(tr.Position.X-my.X,0,tr.Position.Z-my.Z)
                if flat.Magnitude > 0.1 then
                    local n = flat.Unit
                    root.AssemblyLinearVelocity = Vector3.new(n.X*30, -40, n.Z*30)
                end
            end
            if m5("DiveEcho") and s.hist and #s.hist >= 2 then
                -- second echo: re-aim 80ms later along same dive
                if s.lastFire and now - s.lastFire > 0.08 and now - s.lastFire < 0.16 and not s.echoed then
                    s.echoed = true
                    local land = s.land or tr.Position
                    local stand = Vector3.new(land.X, land.Y, land.Z) + Vector3.new(my.X-land.X,0,my.Z-land.Z).Unit * 3
                    pcall(function() root.CFrame = CFrame.new(stand, land) end)
                end
                if s.lastFire and now - s.lastFire > 0.4 then s.echoed = nil end
            end
        end
        if mem.punish and now < mem.punish and mem.focus and mem.focus.Parent then
            local tpos = mem.focus.Position
            local flat = Vector3.new(tpos.X-my.X,0,tpos.Z-my.Z)
            if m5("LandFace") or m5("HoldGround") or m5("AfterShock") or m5("ImpactSeat") then
                if flat.Magnitude > 0.1 then
                    pcall(function()
                        root.CFrame = CFrame.new(my) * (CFrame.lookAt(my, Vector3.new(tpos.X,my.Y,tpos.Z)) - my)
                    end)
                end
            end
            if m5("HoldGround") then
                local v2 = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v2.X*0.7, math.min(v2.Y, -5), v2.Z*0.7)
            end
            if (m5("AfterShock") or m5("ContactPrime") or m5("FinalInch")) and autoSwingEnabled ~= false then
                local bat = m5Bat(char, hum)
                if bat then pcall(function() bat:Activate() end) end
            end
            if m5("FinalInch") and flat.Magnitude > 2.5 and flat.Magnitude < 7 then
                local n = flat.Unit
                root.AssemblyLinearVelocity = Vector3.new(v.X+n.X*20, v.Y, v.Z+n.Z*20)
            end
        end
        if mem.stage2 and now >= mem.stage2 then
            mem.stage2 = nil
            if mem.focus and mem.focus.Parent and m5("TwoStage") then
                local tpos = mem.focus.Position
                pcall(function()
                    local stand = tpos + Vector3.new(my.X-tpos.X,0,my.Z-tpos.Z).Unit * 3.1
                    root.CFrame = CFrame.new(Vector3.new(stand.X, tpos.Y, stand.Z), tpos)
                end)
            end
        end

        -- AIMX family
        if aimOn and tr and d and d < 40 then
            local tpos = tr.Position
            local tv = (s and s.vel) or tr.AssemblyLinearVelocity
            local acc = (s and s.acc) or Vector3.zero
            local lead = 0.1
            if m5("LeadCurve") then lead = lead + math.clamp(tv.Magnitude/400, 0, 0.1) end
            if m5("AccelBias") then lead = lead + 0.03 end
            local pred = tpos + tv * lead
            if m5("AccelBias") or m5("LeadCurve") then pred = pred + acc * (0.5*lead*lead) end
            if m5("GhostLead") and s and s.hist and #s.hist > 3 then
                local old = s.hist[math.max(1, #s.hist-3)].p
                pred = pred:Lerp(tpos + (tpos - old), 0.25)
            end
            if m5("DeadReckon") then
                pred = tpos + tv * 0.14
            end
            if m5("FutureShadow") then
                pred = tpos + tv * 0.18 + acc * 0.01
            end
            local flat = Vector3.new(pred.X-my.X, 0, pred.Z-my.Z)
            if flat.Magnitude > 0.1 then
                local dir = flat.Unit
                if m5("InsideCut") then
                    local side = Vector3.new(-dir.Z,0,dir.X)
                    dir = (dir*0.75 + side*0.25).Unit
                end
                if m5("OutsideCut") then
                    local side = Vector3.new(-dir.Z,0,dir.X)
                    dir = (dir*0.7 - side*0.3).Unit
                end
                if m5("BackArc") then
                    local look = tr.CFrame.LookVector
                    local back = Vector3.new(-look.X,0,-look.Z)
                    if back.Magnitude > 0.1 then dir = (dir*0.5 + back.Unit*0.5).Unit end
                end
                local spd = 32
                if m5("SpeedMatch") then spd = math.clamp(Vector3.new(tv.X,0,tv.Z).Magnitude * 0.9, 24, 70) end
                if m5("GapClose") and d > 10 then spd = spd + 12 end
                if m5("AntiOvershoot") and d < 6 then spd = math.min(spd, 28) end
                if m5("RingKeep") and d < 5 then
                    -- maintain ring distance
                    dir = -dir; spd = 18
                end
                local blend = 0.16
                if m5("MicroCorrect") then blend = 0.1 end
                if m5("VectorBias") then blend = 0.22 end
                if m5("ChaseDamp") then blend = blend * 0.7 end
                root.AssemblyLinearVelocity = Vector3.new(
                    v.X + (dir.X*spd - v.X)*blend,
                    v.Y,
                    v.Z + (dir.Z*spd - v.Z)*blend
                )
                if m5("HeightBlend") then
                    local dy = pred.Y - my.Y
                    root.AssemblyLinearVelocity = Vector3.new(
                        root.AssemblyLinearVelocity.X,
                        root.AssemblyLinearVelocity.Y + dy * 8 * 0.15,
                        root.AssemblyLinearVelocity.Z
                    )
                end
                if m5("FaceLead") or m5("LockPulse") then
                    local face = CFrame.lookAt(my, Vector3.new(pred.X, my.Y, pred.Z))
                    pcall(function() root.CFrame = root.CFrame:Lerp(CFrame.new(my)*(face-my), m5("LockPulse") and 0.35 or 0.18) end)
                end
                if m5("StickyArc") and d < 12 then
                    local side = Vector3.new(-dir.Z,0,dir.X)*math.sin(now*6)*6
                    local vv = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(vv.X+side.X*0.15, vv.Y, vv.Z+side.Z*0.15)
                end
            end
        end

        -- Exotic X family
        if tr and d then
            if m5("JerkSense") and s and (s.jerk or 0) > 200 and d < 22 then
                local flat = Vector3.new(tr.Position.X-my.X,0,tr.Position.Z-my.Z)
                if flat.Magnitude > 0.1 then
                    local n = flat.Unit
                    root.AssemblyLinearVelocity = Vector3.new(v.X+n.X*20, v.Y, v.Z+n.Z*20)
                end
            end
            if m5("PhaseStep") and s and s.tpDown then
                -- single lateral phase shift instead of pure chase
                local side = Vector3.new(-(tr.Position.Z-my.Z),0,(tr.Position.X-my.X))
                if side.Magnitude > 0.1 then
                    side = side.Unit
                    root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*18, v.Y-20, v.Z+side.Z*18)
                end
            end
            if m5("SilenceGap") and d > 7 and d < 11 then
                -- hold still-ish to desync their prediction of your close
                root.AssemblyLinearVelocity = Vector3.new(v.X*0.5, v.Y, v.Z*0.5)
            end
            if m5("MirrorSeed") and aimOn then
                local ev = Vector3.new(tr.AssemblyLinearVelocity.X,0,tr.AssemblyLinearVelocity.Z)
                if ev.Magnitude > 8 then
                    local against = -ev.Unit
                    root.AssemblyLinearVelocity = Vector3.new(v.X+against.X*10, v.Y, v.Z+against.Z*10)
                end
            end
            if m5("OrbitSeed") and d > 5 and d < 14 then
                local to = Vector3.new(tr.Position.X-my.X,0,tr.Position.Z-my.Z)
                if to.Magnitude > 0.1 then
                    local side = Vector3.new(-to.Z,0,to.X).Unit
                    root.AssemblyLinearVelocity = Vector3.new(v.X+side.X*14, v.Y, v.Z+side.Z*14)
                end
            end
            if m5("ErrorCancel") then
                local prev = mem.lastPos
                mem.lastPos = my
                if prev then
                    local delta = my - prev
                    local md = hum.MoveDirection
                    if md.Magnitude > 0.1 and delta.Magnitude > 0.05 then
                        local flat = Vector3.new(delta.X,0,delta.Z)
                        if flat.Magnitude > 0.05 and flat.Unit:Dot(md.Unit) < -0.4 then
                            root.AssemblyLinearVelocity = Vector3.new(md.X*26, v.Y, md.Z*26)
                        end
                    end
                end
            end
            if m5("PathMemory") and aimOn then
                local id = plr and plr.UserId
                if id then
                    local path = mem.path[id]
                    if not path then path = {}; mem.path[id]=path end
                    path[#path+1] = tr.Position
                    while #path > 8 do table.remove(path,1) end
                    if #path >= 4 then
                        local avg = Vector3.zero
                        for i=1,#path do avg = avg + path[i] end
                        avg = avg / #path
                        local flat = Vector3.new(avg.X-my.X,0,avg.Z-my.Z)
                        if flat.Magnitude > 0.1 then
                            local n = flat.Unit
                            root.AssemblyLinearVelocity = Vector3.new(v.X+(n.X*24-v.X)*0.12, v.Y, v.Z+(n.Z*24-v.Z)*0.12)
                        end
                    end
                end
            end
            if m5("FallWindow") and s and s.vel and s.vel.Y < -25 and d < 16 then
                mem.punish = now + 0.2
                mem.focus = tr
            end
            if m5("RiseWindow") and s and s.vel and s.vel.Y > 25 and d < 16 then
                local v2 = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v2.X, math.max(v2.Y, 38), v2.Z)
                hum.Jump = true
            end
            if m5("SnapBudget") then
                mem.snaps = mem.snaps or 0
                if s and s.tpDown and mem.snaps < 3 then
                    mem.snaps = mem.snaps + 1
                end
                if now - (mem.snapReset or 0) > 2 then mem.snaps = 0; mem.snapReset = now end
            end
            if m5("SoftHard") and d < 6 then
                local flat = Vector3.new(tr.Position.X-my.X,0,tr.Position.Z-my.Z)
                if flat.Magnitude > 0.1 then
                    root.AssemblyLinearVelocity = Vector3.new(flat.Unit.X*22, v.Y, flat.Unit.Z*22)
                end
            end
            if m5("EdgeOwner") then
                pcall(function() if root.SetNetworkOwner then root:SetNetworkOwner(LP) end end)
            end
            if m5("SwingPhase") and d < 7 and autoSwingEnabled ~= false then
                local bat = char:FindFirstChildOfClass("Tool") or m5Bat(char, hum)
                if bat and (now - (mem.lastSwing or 0) > 0.13) then
                    mem.lastSwing = now
                    pcall(function() bat:Activate() end)
                end
            end
            if m5("ContactPrime") and d < 5.5 then
                local flat = Vector3.new(tr.Position.X-my.X,0,tr.Position.Z-my.Z)
                if flat.Magnitude > 0.1 then
                    pcall(function()
                        local face = CFrame.lookAt(my, Vector3.new(tr.Position.X,my.Y,tr.Position.Z))
                        root.CFrame = CFrame.new(my)*(face-my)
                    end)
                end
            end
        end
    end)
end

