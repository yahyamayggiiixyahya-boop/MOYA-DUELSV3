    LPH_ATTRIBUTES(VM(NONE))
    _G.latencyGhostEnabled = false
    _G.LatencyGhost.enabled = false
    if _G.LatencyGhost.conn then pcall(function() _G.LatencyGhost.conn:Disconnect() end); _G.LatencyGhost.conn=nil end
end

-- TP Intercept: professional anti-TP-Down.
-- Detects vertical discontinuity, raycasts landing pad, pre-positions on the
-- intercept plane BEHIND the target, opens a short punish window for bat contact.
-- Edge-triggered only (not every frame spam) to avoid server noise.
_G.tpInterceptEnabled = false
_G.TPIntercept = _G.TPIntercept or {
    enabled = false,
    conn = nil,
    samples = {},   -- [userId] = { {t,p}, ... }
    punishUntil = 0,
    focus = nil,
    lastFire = {},
}

local function _tpiRayGround(fromPos, excludeList)
    local gy = fromPos.Y - 4
    pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = excludeList or {}
        local res = workspace:Raycast(fromPos + Vector3.new(0, 2, 0), Vector3.new(0, -220, 0), params)
        if res then gy = res.Position.Y end
    end)
    return gy
end

function _G.TPIntercept.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.tpInterceptEnabled = true
    _G.TPIntercept.enabled = true
    _G.TPIntercept.samples = {}
    if _G.TPIntercept.conn then pcall(function() _G.TPIntercept.conn:Disconnect() end) end
    _G.TPIntercept.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.TPIntercept.enabled then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end

        local now = tick()
        local my = root.Position
        local exclude = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then exclude[#exclude+1] = p.Character end
        end

        -- sample all enemies
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local id = plr.UserId
                    local buf = _G.TPIntercept.samples[id]
                    if not buf then buf = {}; _G.TPIntercept.samples[id] = buf end
                    local pos = tr.Position
                    buf[#buf+1] = {t=now, p=pos}
                    while #buf > 12 do table.remove(buf, 1) end
                    if #buf >= 3 then
                        local a, b = buf[#buf-2], buf[#buf]
                        local dt = math.max(b.t - a.t, 1/240)
                        local disp = b.p - a.p
                        local flat = Vector3.new(disp.X, 0, disp.Z)
                        -- TP-Down signature: big negative Y, limited horizontal travel
                        local tpDown = (disp.Y < -7 and flat.Magnitude < 22)
                            or (disp.Y < -4 and flat.Magnitude < 10 and (disp.Y / dt) < -55)
                        local lastFire = _G.TPIntercept.lastFire[id] or 0
                        if tpDown and (now - lastFire) > 0.4 then
                            _G.TPIntercept.lastFire[id] = now
                            -- landing pad under final sample
                            local groundY = _tpiRayGround(b.p, exclude)
                            local land = Vector3.new(b.p.X, groundY + 3.1, b.p.Z)
                            -- residual horizontal velocity estimate
                            local vFlat = flat / dt
                            if vFlat.Magnitude > 90 then vFlat = vFlat.Unit * 90 end
                            -- stand behind their look or behind displacement
                            local back
                            local look = tr.CFrame.LookVector
                            local lookFlat = Vector3.new(look.X, 0, look.Z)
                            if lookFlat.Magnitude > 0.15 then
                                back = -lookFlat.Unit
                            elseif flat.Magnitude > 0.15 then
                                back = -flat.Unit
                            else
                                back = Vector3.new(my.X - land.X, 0, my.Z - land.Z)
                                back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0, 0, 1)
                            end
                            local side = Vector3.new(-back.Z, 0, back.X)
                            local stand = land + back * 3.4 + side * 1.15
                            -- edge fire: one intercept placement + punish window
                            pcall(function()
                                root.CFrame = CFrame.new(stand, Vector3.new(land.X, stand.Y, land.Z))
                                root.AssemblyLinearVelocity = Vector3.new(vFlat.X * 0.5, -35, vFlat.Z * 0.5)
                                root.AssemblyAngularVelocity = Vector3.zero
                            end)
                            _G.TPIntercept.punishUntil = now + 0.28
                            _G.TPIntercept.focus = tr
                            -- equip + swing prep
                            local bat = char:FindFirstChildOfClass("Tool")
                            if not bat then
                                local bp = LP:FindFirstChild("Backpack")
                                if bp then
                                    for _, t in ipairs(bp:GetChildren()) do
                                        if t:IsA("Tool") then
                                            local n = t.Name:lower()
                                            if n:find("bat") or n:find("slap") then
                                                pcall(function() hum:EquipTool(t) end)
                                                bat = t
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        -- punish window: stay glued to focus at ground band and swing
        if now < (_G.TPIntercept.punishUntil or 0) and _G.TPIntercept.focus then
            local tr = _G.TPIntercept.focus
            if tr and tr.Parent then
                local tpos = tr.Position
                local flat = Vector3.new(tpos.X - my.X, 0, tpos.Z - my.Z)
                if flat.Magnitude > 0.1 then
                    local face = CFrame.lookAt(my, Vector3.new(tpos.X, my.Y, tpos.Z))
                    pcall(function()
                        root.CFrame = CFrame.new(my) * (face - face.Position)
                    end)
                    if flat.Magnitude > 3.5 and flat.Magnitude < 14 then
                        local n = flat.Unit
                        local v = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(v.X + n.X * 22, math.min(v.Y, -8), v.Z + n.Z * 22)
                    end
                end
                if autoSwingEnabled ~= false then
                    local bat = char:FindFirstChildOfClass("Tool")
                    if bat then pcall(function() bat:Activate() end) end
                end
            end
        end
    end)
end

