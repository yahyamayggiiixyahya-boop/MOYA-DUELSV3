function _G.PhaseEdge.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.PhaseEdge.enabled = true
    _G.phaseEdgeEnabled = true
    if _G.PhaseEdge.conn then pcall(function() _G.PhaseEdge.conn:Disconnect() end) end
    local sig = RunService.PreSimulation or RunService.Stepped
    _G.PhaseEdge.conn = sig:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.PhaseEdge.enabled then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end
        pcall(function()
            if root.SetNetworkOwner then root:SetNetworkOwner(LP) end
        end)
        local v = root.AssemblyLinearVelocity
        local md = hum.MoveDirection
        -- preserve intentional motion, kill only pure rubberband spikes against move dir
        if md.Magnitude > 0.1 then
            local flat = Vector3.new(v.X, 0, v.Z)
            local want = Vector3.new(md.X, 0, md.Z).Unit
            if flat.Magnitude > 8 then
                local against = flat.Unit:Dot(want) < -0.55
                if against then
                    -- cancel only the backward component
                    local back = flat:Dot(want) -- negative if against
                    local fix = flat - want * back
                    root.AssemblyLinearVelocity = Vector3.new(fix.X, v.Y, fix.Z)
                end
            end
            _G.PhaseEdge.lastGood = Vector3.new(want.X * math.min(flat.Magnitude, 40), v.Y, want.Z * math.min(flat.Magnitude, 40))
        else
            _G.PhaseEdge.lastGood = Vector3.new(0, v.Y, 0)
        end
        -- damp insane angular only at physics edge
        if root.AssemblyAngularVelocity.Magnitude > 30 then
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end
