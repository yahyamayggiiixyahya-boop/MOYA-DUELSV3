    -- MOYA DUELS TP Down: from FR HUB V5 chase + mirror TP-down (adapted)
    local _frMtTracked, _frMtPrevY = nil, nil
    local _frSwingCD = false
    local function avFrTpDownStep()
        LPH_ATTRIBUTES(VM(NONE))
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then return end
        if hum.PlatformStand then pcall(function() hum.PlatformStand = false end) end
        hum.AutoRotate = false

        local bat = char:FindFirstChildOfClass("Tool")
        if not bat then
            local b = nanzFindBat and nanzFindBat()
            if b then pcall(function() hum:EquipTool(b) end); bat = b end
        end

        local myPos = root.Position
        local best, bd, bestPlr = nil, 55, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local th = plr.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local d = (tr.Position - myPos).Magnitude
                    if d < bd then bd, best, bestPlr = d, tr, plr end
                end
            end
        end
        if not best then return end

        -- Mirror TP-Down: follow hard drops without launching away
        if _frMtTracked ~= best then
            _frMtTracked = best
            _frMtPrevY = best.Position.Y
        else
            local y = best.Position.Y
            local drop = (_frMtPrevY or y) - y
            _frMtPrevY = y
            local tVelY = best.AssemblyLinearVelocity.Y
            if drop > 20 or (drop > 8 and tVelY < -80) then
                local landY = y
                pcall(function()
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local excl = {}
                    for _, p in ipairs(Players:GetPlayers()) do if p.Character then excl[#excl+1]=p.Character end end
                    params.FilterDescendantsInstances = excl
                    local hit = workspace:Raycast(best.Position + Vector3.new(0, 2, 0), Vector3.new(0, -250, 0), params)
                    if hit then landY = hit.Position.Y + 3.05 end
                end)
                -- stand slightly BEHIND target, not on top (prevents push-off / fly away)
                local look = best.CFrame.LookVector
                local back = Vector3.new(-look.X, 0, -look.Z)
                if back.Magnitude < 0.1 then
                    back = Vector3.new(myPos.X - best.Position.X, 0, myPos.Z - best.Position.Z)
                end
                back = back.Magnitude > 0.1 and back.Unit or Vector3.new(0, 0, 1)
                local stand = Vector3.new(best.Position.X, landY, best.Position.Z) + back * 3.0
                root.CFrame = root.CFrame:Lerp(CFrame.new(stand, Vector3.new(best.Position.X, stand.Y, best.Position.Z)), 0.28)
                root.AssemblyLinearVelocity = Vector3.new(0, -15, 0)
                root.AssemblyAngularVelocity = Vector3.zero
                if autoSwingEnabled ~= false and bat then
                    pcall(function() bat:Activate() end)
                end
                return
            end
        end

        local targetPos = best.Position
        local targetVel = best.AssemblyLinearVelocity
        local predictPos = targetPos + targetVel * 0.12
        local direction = predictPos - myPos
        if direction.Magnitude < 0.01 then return end
        local flatDir = Vector3.new(direction.X, 0, direction.Z)
        if flatDir.Magnitude < 0.01 then return end
        flatDir = flatDir.Unit

        local baseSpeed = 58
        pcall(function()
            if type(aimbotSpeedValue) == "number" then baseSpeed = aimbotSpeedValue end
        end)
        -- CONTACT RING: slow hard near target so we don't yeet past after hit
        local chaseSpeed = baseSpeed
        if bd < 5 then
            chaseSpeed = math.min(baseSpeed, 18)
        elseif bd < 8 then
            chaseSpeed = math.min(baseSpeed, 28)
        elseif bd < 12 then
            chaseSpeed = math.min(baseSpeed, 40)
        end

        local desiredHeight = targetPos.Y + 3.2
        local yVel = (desiredHeight - myPos.Y) * 16 + targetVel.Y * 0.55
        if hum.FloorMaterial ~= Enum.Material.Air then yVel = math.max(yVel, 8) end
        yVel = math.clamp(yVel, -55, 90)

        local desired = Vector3.new(flatDir.X * chaseSpeed, yVel, flatDir.Z * chaseSpeed)
        local cur = root.AssemblyLinearVelocity
        -- softer lerp when close (no explosion after hit)
        local alpha = bd < 7 and 0.45 or 0.75
        root.AssemblyLinearVelocity = cur:Lerp(desired, alpha)

        -- face only (light angular) — no huge spin impulse that flings
        if bd < 16 then
            local face = CFrame.lookAt(myPos, Vector3.new(targetPos.X, myPos.Y, targetPos.Z))
            root.CFrame = root.CFrame:Lerp(CFrame.new(myPos) * (face - face.Position), 0.22)
            if root.AssemblyAngularVelocity.Magnitude > 12 then
                root.AssemblyAngularVelocity = root.AssemblyAngularVelocity * 0.2
            end
        end

        if autoSwingEnabled ~= false and bat and not _frSwingCD and bd <= 7 then
            _frSwingCD = true
            pcall(function()
                bat:Activate()
                local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
                if ev then ev:FireServer() end
            end)
            task.delay(0.1, function() _frSwingCD = false end)
        end
    end

-- AIMBOT V3: anti TP-down / ping-lagger / anti-bat / juke tracker
    local function avAimbotV3Step()
        LPH_ATTRIBUTES(VM(NONE))
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root then return end
        if hum.Health <= 0 then return end
        if hum.PlatformStand then pcall(function() hum.PlatformStand = false end) end
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            local lv = root.AssemblyLinearVelocity
            if lv.Magnitude > 300 then root.AssemblyLinearVelocity = lv.Unit * 95 end
            if root.AssemblyAngularVelocity.Magnitude > 40 then root.AssemblyAngularVelocity = Vector3.zero end
        end)

        local bat = char:FindFirstChildOfClass("Tool")
        if not bat then
            bat = nanzFindBat and nanzFindBat() or nil
            if bat then pcall(function() hum:EquipTool(bat) end) end
        end

        local target = avGetTarget()
        if not target then
            hum.AutoRotate = true
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(Vector3.zero, 0.3)
            return
        end
        local tHum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
        if not tHum or tHum.Health <= 0 then
            AV.target = nil
            return
        end
        AV.target = target
        hum.AutoRotate = false

        local myPos = root.Position
        local targetPos = target.Position
        local now = tick()
        local T = AV.T
        local teleported = AV.track(target, now)

        -- measured vel (immune to fake server velocity) + real part vel blend
        local measVel = T.vel or Vector3.zero
        local partVel = target.AssemblyLinearVelocity or Vector3.zero
        local targetVel = measVel
        if partVel.Magnitude > measVel.Magnitude * 1.15 then
            -- ping lagger / high speed: trust higher of the two on flat plane
            targetVel = Vector3.new(
                (math.abs(partVel.X) > math.abs(measVel.X) and partVel.X or measVel.X),
                partVel.Y,
                (math.abs(partVel.Z) > math.abs(measVel.Z) and partVel.Z or measVel.Z)
            )
        end
        local acc = T.acc or Vector3.zero

        -- hard snap on TP down / blink
        if teleported then
            T.snapUntil = now + 0.28
        end
        if now < (T.snapUntil or 0) then
            local back = Vector3.new(myPos.X - targetPos.X, 0, myPos.Z - targetPos.Z)
            if back.Magnitude < 0.4 then
                local lv = target.CFrame.LookVector
                back = Vector3.new(-lv.X, 0, -lv.Z)
            end
            back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)
            -- stand slightly to the SIDE + behind to beat anti-bat front block
            local side = Vector3.new(-back.Z, 0, back.X)
            local stand = targetPos + back * 3.2 + side * 1.4
            stand = Vector3.new(stand.X, targetPos.Y, stand.Z)
            pcall(function()
                root.CFrame = root.CFrame:Lerp(CFrame.new(stand, Vector3.new(targetPos.X, stand.Y, targetPos.Z)), 0.28)
                root.AssemblyLinearVelocity = Vector3.new(targetVel.X, math.min(targetVel.Y, 0), targetVel.Z)
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            if autoSwingEnabled ~= false then
                local b = char:FindFirstChildOfClass("Tool")
                if b then pcall(function() b:Activate() end) end
            end
            return
        end

        -- anti-juke: if target accelerates opposite to our approach, cut the corner
        local toMe = Vector3.new(myPos.X - targetPos.X, 0, myPos.Z - targetPos.Z)
        local approach = toMe.Magnitude > 0.01 and (-toMe).Unit or Vector3.zero
        local flatTV = Vector3.new(targetVel.X, 0, targetVel.Z)
        local juke = false
        if approach.Magnitude > 0.01 and flatTV.Magnitude > 12 then
            local dot = approach:Dot(flatTV.Unit)
            if dot < -0.25 then
                juke = true
            end
        end

        -- lead time scales with lag speed (up to ~145 style movement)
        local spdMag = flatTV.Magnitude
        local lead = math.clamp(0.08 + spdMag / 220, 0.08, 0.28)
        if juke then
            -- predict opposite cut: lead more on acceleration
            lead = lead + 0.06
        end
        local leadPos = targetPos + targetVel * lead + acc * (lead * lead * 0.5)
        -- anti-bat stand: approach from behind-side of predicted point
        local lookFlat = Vector3.new(target.CFrame.LookVector.X, 0, target.CFrame.LookVector.Z)
        if lookFlat.Magnitude < 0.05 then lookFlat = flatTV.Magnitude > 0.05 and flatTV.Unit or Vector3.new(0, 0, 1) else lookFlat = lookFlat.Unit end
        local behind = -lookFlat
        local side = Vector3.new(-behind.Z, 0, behind.X)
        local goal = leadPos + behind * 2.8 + side * (juke and 2.2 or 1.2)
        goal = Vector3.new(goal.X, leadPos.Y, goal.Z)

        local dir = goal - myPos
        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude < 0.01 then
            flatDir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
        end
        if flatDir.Magnitude < 0.01 then return end
        flatDir = flatDir.Unit

        -- face predicted point
        local facePos = Vector3.new(leadPos.X, myPos.Y, leadPos.Z)
        if (facePos - myPos).Magnitude > 0.1 then
            local diffCF = root.CFrame:Inverse() * CFrame.lookAt(myPos, facePos)
            local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
            root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(
                Vector3.new(math.clamp(rx, -2.8, 2.8) * 48, math.clamp(ry, -2.8, 2.8) * 48, math.clamp(rz, -2.8, 2.8) * 48))
        else
            root.AssemblyAngularVelocity = Vector3.zero
        end

        local settings = JoxAimbotSettings or {}
        local speed = tonumber(settings.normalSpeed) or tonumber(aimbotSpeedValue) or 58
        if type(NanzV3) == "table" and NanzV3.cap then
            speed = NanzV3.cap(speed, (NanzV3.SPD and NanzV3.SPD.V1) or 85)
        end
        -- match high target speed so we don't lag behind ping-lagger
        if spdMag > 50 then
            speed = math.min(math.max(speed, spdMag * 0.92), 120)
        elseif flatDir.Magnitude > 0 and (goal - myPos).Magnitude > 18 then
            speed = math.min(speed * 1.2, 90)
        end

        local dy = goal.Y - myPos.Y
        -- TP-down already falling: dive hard
        if targetVel.Y < -40 or dy < -4 then
            dy = math.min(dy, targetPos.Y - myPos.Y)
        end
        local yVel = dy * 22 + targetVel.Y * 0.85
        if hum.FloorMaterial ~= Enum.Material.Air then yVel = math.max(yVel, 10) end
        if dy > 2 then
            yVel = math.max(yVel, math.clamp(dy * 26, 44, 118))
            pcall(function()
                hum.Jump = true
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        elseif dy < -1.5 then
            yVel = math.min(yVel, math.clamp(dy * 28, -120, -10))
        end
        yVel = math.clamp(yVel, -120, 118)

        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(
            Vector3.new(flatDir.X * speed, yVel, flatDir.Z * speed), 0.88)

        if flatDir.Magnitude > 0.1 then
            pcall(function() hum:Move(flatDir, false) end)
        end

        local dist = (root.Position - target.Position).Magnitude
        if autoSwingEnabled ~= false and dist <= 9 then
            local b = char:FindFirstChildOfClass("Tool") or bat
            if b and b:IsA("Tool") then
                pcall(function() b:Activate() end)
            end
        end
    end

    -- Anti Bypass mode
    local AV_AB = {SPEED = 63, VERT_SPEED = 52, DISTANCE = -2.8, HEIGHT = 4.75, V_OFFSET = 1, MAX_TURN_RATE = 28}
    local function avAbEnsureBat()
        LPH_ATTRIBUTES(VM(NONE))
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then return nil end
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then return equipped end
        local bat = nanzFindBat()
        if bat then pcall(function() hum:EquipTool(bat) end) end
        return bat
    end
    local function avAbSwing()
        LPH_ATTRIBUTES(VM(NONE))
        if AV.swingCd then return end
        AV.swingCd = true
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            local bat = avAbEnsureBat()
            if autoSwingEnabled ~= false and bat and bat:IsA("Tool") then bat:Activate() end
        end)
        task.delay(0.3, function() AV.swingCd = false end)
    end
    local function avAntiBypassStep()
        LPH_ATTRIBUTES(VM(NONE))
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root or hum.Health <= 0 then return end
        hum.AutoRotate = false
        avAbEnsureBat()
        local target, targetDist = avClosest()
        if not target then
            root.AssemblyAngularVelocity = Vector3.zero
            return
        end
        local nowA = tick()
        if AV.track(target, nowA) and (target.Position - root.Position).Magnitude <= 300 then
            AV.T.snapUntil = nowA + 0.2
        end
        if nowA < AV.T.snapUntil then
            local tpA, mpA = target.Position, root.Position
            local backA = Vector3.new(mpA.X - tpA.X, 0, mpA.Z - tpA.Z)
            if backA.Magnitude < 0.5 then
                local lvA = target.CFrame.LookVector
                backA = Vector3.new(-lvA.X, 0, -lvA.Z)
            end
            backA = backA.Magnitude > 0.01 and backA.Unit or Vector3.new(0, 0, 1)
            local standA = tpA + backA * 3.5
            pcall(function()
                root.CFrame = root.CFrame:Lerp(CFrame.new(standA, Vector3.new(tpA.X, standA.Y, tpA.Z)), 0.28)
                root.AssemblyLinearVelocity = Vector3.new(AV.T.vel.X, 0, AV.T.vel.Z)
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            avAbSwing()
            return
        end
        local gYa = AV.groundY(target)
        local waitingA = aimbotHeightLockEnabled and gYa ~= nil and (target.Position.Y - gYa) > AV.HIGH
        local tposA = waitingA and Vector3.new(target.Position.X, gYa + 3, target.Position.Z) or target.Position
        local aimTargetPos = tposA + Vector3.new(0, AV_AB.V_OFFSET, 0)
        local look = aimTargetPos - root.Position
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 then
            local targetYaw = math.deg(math.atan2(-flatLook.X, -flatLook.Z))
            local yawDelta = (targetYaw - root.Orientation.Y + 180) % 360 - 180
            local yawRate = math.clamp(yawDelta * 8, -AV_AB.MAX_TURN_RATE, AV_AB.MAX_TURN_RATE)
            root.AssemblyAngularVelocity = Vector3.new(0, yawRate, 0)
        else
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if look.Magnitude > 0.01 then
            local dir = look.Unit
            local standPos = aimTargetPos - (dir * AV_AB.DISTANCE) + Vector3.new(0, AV_AB.HEIGHT, 0)
            local moveDir = standPos - root.Position
            local hDir = Vector3.new(moveDir.X, 0, moveDir.Z)
            local settings = JoxAimbotSettings or {}
            local hVel = hDir.Magnitude > 0.1 and hDir.Unit * (tonumber(settings.normalSpeed) or 58) or Vector3.zero
            local vVel = Vector3.new(0, math.clamp(moveDir.Y * 3, -AV_AB.VERT_SPEED, AV_AB.VERT_SPEED), 0)
            root.AssemblyLinearVelocity = hVel + vVel
            if hDir.Magnitude > 0.5 then hum:Move(hDir.Unit, false) end
        end
        if targetDist < 5 then avAbSwing() end
    end

    local function avStart()
        LPH_ATTRIBUTES(VM(NONE))
        if AV.conn then pcall(function() AV.conn:Disconnect() end); AV.conn = nil end
        AV.on = true
        nanzFreezeInput(true) -- player can't walk; the aimbot chases
        AV.target, AV.stickyTarget, AV.stickyUntil, AV.lastScan = nil, nil, 0, 0
        AV.prevAutoRotate = nil
        AV.conn = RunService.Heartbeat:Connect(function()
            LPH_ATTRIBUTES(VM(NONE))
            if not AV.on then return end
            if AIMBOT_MODE == "Anti Bypass" then
                avAntiBypassStep()
            elseif AIMBOT_MODE == "Aimbot V2" then
                avInputV2Step()
            elseif AIMBOT_MODE == "AIMBOT V3" or AIMBOT_MODE == "Aimbot V3" then
                avAimbotV3Step()
            elseif AIMBOT_MODE == "MOYA DUELS TP Down" then
                avFrTpDownStep()
            else
                avNormalStep()
            end
        end)
        if AV.charConn then pcall(function() AV.charConn:Disconnect() end) end
        AV.charConn = LP.CharacterAdded:Connect(function(char)
            LPH_ATTRIBUTES(VM(NONE))
            if not AV.on then return end
            task.wait(0.25)
            local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
            local hum = char:FindFirstChildOfClass("Humanoid")
            pcall(function()
                LPH_ATTRIBUTES(VM(NONE))
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
                if hum then
                    hum.PlatformStand = false
                    hum.AutoRotate = false
                    local bat = nanzFindBat()
                    if bat then hum:EquipTool(bat) end
                end
            end)
        end)
        return true
    end

    -- V1 entry: stops conflicting features then starts the AV engine
    local function avStartWithConflicts()
        LPH_ATTRIBUTES(VM(NONE))
        if AV.on and AV.conn then return true end
        -- Auto Left / Auto Right off while the aimbot runs
        if autoLeftEnabled then autoLeftEnabled = false; if autoLeftSetVisual then pcall(autoLeftSetVisual, false) end; pcall(stopAutoLeft) end
        if autoRightEnabled then autoRightEnabled = false; if autoRightSetVisual then pcall(autoRightSetVisual, false) end; pcall(stopAutoRight) end
        -- Bypass aimbot off (cannot run together)
        if aimbotV2Enabled then
            aimbotV2Enabled = false
            pcall(stopAimbotV2)
            pcall(setVisual, "AimbotV2", false)
            if mobBtnRefs.aimbotV2 then pcall(mobBtnRefs.aimbotV2, false) end
        end
        -- Anti Bat Bypass off
        if joxAntiBatBypassEnabled then
            joxAntiBatBypassEnabled = false
            pcall(stopJoxAntiBatBypass)
            pcall(setVisual, "AntiBatBypass", false)
        end
        joxBatAimbotEnabled = true
        avStart()
        return true
    end

    -- ------------------------------------------------------------
    -- AIMBOT V2 (NANZ/GROK engine): nearest-target lock, velocity
    -- chase + body rotation, auto swing inside 8 studs.
    -- ------------------------------------------------------------
    local G2 = {conn = nil, active = false}
    local g2Players, g2PlayerCacheTime = nil, 0
    local function g2GetPlayersCached()
        LPH_ATTRIBUTES(VM(NONE))
        local now = tick()
        if g2Players and now - g2PlayerCacheTime < 0.03 then return g2Players end
        g2Players = Players:GetPlayers()
        g2PlayerCacheTime = now
        return g2Players
    end
    local function g2Closest()
        LPH_ATTRIBUTES(VM(NONE))
        local character = LP.Character
        if not character then return nil end
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return nil end
        local position = humanoidRootPart.Position
        local playersCached = g2GetPlayersCached()
        local best = math.huge
        local bestRoot = nil
        for i = 1, #playersCached do
            local player = playersCached[i]
            if player ~= LP then
                local character2 = player.Character
                if character2 then
                    local rootPart = character2:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local humanoid = character2:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            local dx = rootPart.Position.X - position.X
                            local dy = rootPart.Position.Y - position.Y
                            local dz = rootPart.Position.Z - position.Z
                            local distSq = dx * dx + dy * dy + dz * dz
                            if distSq < best then
                                best = distSq
                                bestRoot = rootPart
                            end
                        end
                    end
                end
            end
        end
        return bestRoot
    end
    local function g2IsBatTool(tool)
        LPH_ATTRIBUTES(VM(NONE))
        if not tool then return false end
        for _, name in ipairs(NANZ_BAT_SLAP_LIST) do
            if tool.Name == name then return true end
        end
        return tool.Name:lower():find("bat") or tool.Name:lower():find("slap")
    end
    local function g2FindBat()
        LPH_ATTRIBUTES(VM(NONE))
        local character = LP.Character
        if not character then return nil end
        for _, name in ipairs(NANZ_BAT_SLAP_LIST) do
            local t = character:FindFirstChild(name)
            if t and t:IsA("Tool") then return t end
        end
        local backpack = LP:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, name in ipairs(NANZ_BAT_SLAP_LIST) do
                local t = backpack:FindFirstChild(name)
                if t and t:IsA("Tool") then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then pcall(function() humanoid:EquipTool(t) end) end
                    return t
                end
            end
        end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") and (child.Name:lower():find("bat") or child.Name:lower():find("slap")) then
                return child
            end
        end
        return nil
    end
    local function g2Swing()
        LPH_ATTRIBUTES(VM(NONE))
        pcall(function()
            LPH_ATTRIBUTES(VM(NONE))
            local character = LP.Character
            if not character then return end
            local tool = character:FindFirstChildOfClass("Tool")
            if tool and not g2IsBatTool(tool) then return end
            local bat = g2FindBat()
            if bat then
                if bat.Parent ~= character then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then pcall(function() humanoid:EquipTool(bat) end) end
                end
                if autoSwingEnabled ~= false then pcall(function() bat:Activate() end) end
            end
        end)
    end
    local function g2Stop()
        LPH_ATTRIBUTES(VM(NONE))
        if G2.conn then
            pcall(function() G2.conn:Disconnect() end)
            G2.conn = nil
        end
        G2.active = false
        nanzResetMotion()
    end
    table.insert(_G.__NanzCleanupFns, function() g2Stop() end)
    local function g2Start()
        LPH_ATTRIBUTES(VM(NONE))
        if G2.conn then return end
        G2.active = true
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.AutoRotate = false end
        G2.conn = RunService.RenderStepped:Connect(function()
            LPH_ATTRIBUTES(VM(NONE))
            if not joxBatAimbotEnabled then return end
            local character = LP.Character
            if not character then return end
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid2 = character:FindFirstChildOfClass("Humanoid")
            if not rootPart or not humanoid2 then return end
            if not character:FindFirstChildOfClass("Tool") then
                local bat = g2FindBat()
                if bat then
                    pcall(function() humanoid2:EquipTool(bat) end)
                end
            end
            local targetRoot = g2Closest()
            if not targetRoot then return end
            local settings = JoxAimbotSettings or {}
            local speed = tonumber(settings.normalSpeed) or tonumber(aimbotSpeedValue) or 58
            local targetVel = targetRoot.AssemblyLinearVelocity
            local position = rootPart.Position
            local position2 = targetRoot.Position
            local vector = position2 + targetVel * 0.14 + targetRoot.CFrame.LookVector * 0.3 - position
            local flat = Vector3.new(vector.X, 0, vector.Z)
            local unit
            if 0 < flat.Magnitude then
                unit = flat.Unit
            else
                unit = Vector3.new(0, 0, 0)
            end
            local yTarget = (position2.Y + 3.7 - position.Y) * 19.5 + targetVel.Y * 0.8
            local yVel
            if humanoid2.FloorMaterial == Enum.Material.Air then
                yVel = yTarget
            else
                yVel = math.max(yTarget, 13)
            end
            rootPart.AssemblyLinearVelocity = rootPart.AssemblyLinearVelocity:Lerp(
                Vector3.new(unit.X * speed, math.clamp(yVel, -70, 110), unit.Z * speed),
                0.2
            )
            local predicted = position2 + targetVel * math.clamp(targetVel.Magnitude / 150, 0.05, 0.2)
            if (predicted - position).Magnitude > 0.1 then
                local object = CFrame.lookAt(position, predicted)
                local rx, ry, rz = (rootPart.CFrame:Inverse() * object):ToEulerAnglesXYZ()
                rootPart.AssemblyAngularVelocity = rootPart.CFrame:VectorToWorldSpace(
                    Vector3.new(
                        math.clamp(rx, -2.5, 2.5) * 42,
                        math.clamp(ry, -2.5, 2.5) * 42,
                        math.clamp(rz, -2.5, 2.5) * 42
                    )
                )
            end
            -- auto swing: always active while Aimbot V2 is running
            if (rootPart.Position - targetRoot.Position).Magnitude <= 8 then
                g2Swing()
            end
        end)
    end

    -- dispatcher for the Jox "Bat Aimbot" control
    nanzStartAim = function()
        LPH_ATTRIBUTES(VM(NONE))
        if AIMBOT_VERSION == "V2" then
            if G2.conn then return true end
            pcall(avStop) -- make sure V1 is off
            -- Auto Left / Auto Right off while the aimbot runs
            if autoLeftEnabled then autoLeftEnabled = false; if autoLeftSetVisual then pcall(autoLeftSetVisual, false) end; pcall(stopAutoLeft) end
            if autoRightEnabled then autoRightEnabled = false; if autoRightSetVisual then pcall(autoRightSetVisual, false) end; pcall(stopAutoRight) end
            -- Bypass aimbot off (cannot run together)
            if aimbotV2Enabled then
                aimbotV2Enabled = false
                pcall(stopAimbotV2)
                pcall(setVisual, "AimbotV2", false)
                if mobBtnRefs.aimbotV2 then pcall(mobBtnRefs.aimbotV2, false) end
            end
            -- Anti Bat Bypass off
            if joxAntiBatBypassEnabled then
                joxAntiBatBypassEnabled = false
                pcall(stopJoxAntiBatBypass)
                pcall(setVisual, "AntiBatBypass", false)
            end
            joxBatAimbotEnabled = true
            nanzFreezeInput(true) -- player can't walk; the aimbot chases
            g2Start()
            return true
        else
            if G2.conn or G2.active then g2Stop() end
            return avStartWithConflicts()
        end
    end

    nanzStopAim = function()
        LPH_ATTRIBUTES(VM(NONE))
        if AV.on or AV.conn then avStop() end
        if G2.conn or G2.active then g2Stop() end
        joxBatAimbotEnabled = false
        nanzFreezeInput(aimbotV2Enabled == true)
    end

    -- switch mode Normal <-> Anti Bypass (restarts if running)
    setAimbotMode = function(mode)
        LPH_ATTRIBUTES(VM(NONE))
        if mode == "Anti Bypass" then
            mode = "Anti Bypass"
        elseif mode == "Aimbot V2" or mode == "Input V2" or mode == "V2" then
            mode = "Aimbot V2"
        elseif mode == "AIMBOT V3" or mode == "Aimbot V3" or mode == "V3" then
            mode = "AIMBOT V3"
        elseif mode == "MOYA DUELS TP Down" or mode == "FRTP" or mode == "MOYA DUELS TP Down" or mode == "TP Down" then
            mode = "MOYA DUELS TP Down"
        else
            mode = "Normal"
        end
        local wasOn = AV.on
        if wasOn then avStop() end
        AIMBOT_MODE = mode
        if wasOn then avStart() end
    end

    -- switch Aimbot V1 <-> V2 (restarts if running)
    setAimbotVersion = function(ver)
        LPH_ATTRIBUTES(VM(NONE))
        ver = (ver == "V2") and "V2" or "V1"
        local wasOn = joxBatAimbotEnabled == true
        if wasOn then nanzStopAim() end
        AIMBOT_VERSION = ver
        if wasOn then nanzStartAim() end
    end
end

