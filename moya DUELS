-- Spin Bot (FR HUB style, faster spin)
_G.spinBotEnabled = false
_G.SpinBot = _G.SpinBot or {bav=nil, conn=nil, charConn=nil}
function _G.SpinBot.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.spinBotEnabled = true
    local function apply(root)
        if not root then return end
        pcall(function()
            if _G.SpinBot.bav then _G.SpinBot.bav:Destroy() end
            local bav = Instance.new("BodyAngularVelocity")
            bav.Name = "MOYA_SpinBot"
            bav.MaxTorque = Vector3.new(0, math.huge, 0)
            bav.AngularVelocity = Vector3.new(0, 130, 0) -- faster spin
            bav.P = 1e5
            bav.Parent = root
            _G.SpinBot.bav = bav
        end)
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then apply(root) end
    if _G.SpinBot.charConn then pcall(function() _G.SpinBot.charConn:Disconnect() end) end
    _G.SpinBot.charConn = LP.CharacterAdded:Connect(function(c)
        if not _G.spinBotEnabled then return end
        task.wait(0.3)
        apply(c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 3))
    end)
end
function _G.SpinBot.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.spinBotEnabled = false
    if _G.SpinBot.bav then pcall(function() _G.SpinBot.bav:Destroy() end); _G.SpinBot.bav=nil end
    if _G.SpinBot.charConn then pcall(function() _G.SpinBot.charConn:Disconnect() end); _G.SpinBot.charConn=nil end
end

-- Spin Bot V2 (from Cz Spin style): CFrame yaw spin + Anti Die while on
_G.spinBotV2Enabled = false
_G.SpinBotV2 = _G.SpinBotV2 or {
    enabled = false,
    conn = nil,
    charConn = nil,
    speed = 1200, -- very fast (Cz default 360)
}
function _G.SpinBotV2.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.spinBotV2Enabled = true
    _G.SpinBotV2.enabled = true
    -- turn off V1 if on (conflict)
    pcall(function() if _G.SpinBot and _G.spinBotEnabled then _G.SpinBot.stop(); if setVisual then setVisual("SpinBot", false) end end end)
    -- Anti Die with spin (Cz behavior)
    pcall(function()
        if _G.AntiDieV2 and _G.AntiDieV2.start then _G.AntiDieV2.start() end
        if setVisual then setVisual("AntiDieV2", true) end
    end)
    if _G.SpinBotV2.conn then pcall(function() _G.SpinBotV2.conn:Disconnect() end); _G.SpinBotV2.conn = nil end
    local function prep(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = false end
    end
    if LP.Character then prep(LP.Character) end
    if _G.SpinBotV2.charConn then pcall(function() _G.SpinBotV2.charConn:Disconnect() end) end
    _G.SpinBotV2.charConn = LP.CharacterAdded:Connect(function(c)
        if not _G.SpinBotV2.enabled then return end
        task.wait(0.1)
        prep(c)
        pcall(function() if _G.AntiDieV2 then _G.AntiDieV2.start() end end)
    end)
    local speed = tonumber(_G.SpinBotV2.speed) or 1200
    _G.SpinBotV2.conn = RunService.Stepped:Connect(function(_, dt)
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.SpinBotV2.enabled then return end
        pcall(function()
            local char = LP.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not root then return end
            if hum and hum.AutoRotate then hum.AutoRotate = false end
            local deg = (speed * dt) % 360
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(deg), 0)
        end)
    end)
end
function _G.SpinBotV2.stop()
    LPH_ATTRIBUTES(VM(NONE))
    _G.spinBotV2Enabled = false
    _G.SpinBotV2.enabled = false
    if _G.SpinBotV2.conn then pcall(function() _G.SpinBotV2.conn:Disconnect() end); _G.SpinBotV2.conn = nil end
    if _G.SpinBotV2.charConn then pcall(function() _G.SpinBotV2.charConn:Disconnect() end); _G.SpinBotV2.charConn = nil end
    pcall(function()
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end)
    -- leave AntiDieV2 as user left it (don't force off — they may want it alone)
end

-- Steal SPIN BOT V2: spin only while holding brainrot, stop when released
_G.stealSpinV2Enabled = false
_G.StealSpinV2 = _G.StealSpinV2 or {enabled=false, conn=nil, wasOn=false}

local function _moyaHoldingBrainrot()
    LPH_ATTRIBUTES(VM(NONE))
    -- ONLY real brainrot hold — NOT carry mode / not generic carrying
    local char = LP.Character
    if not char then return false end

    -- game Stealing attribute (holding stolen animal/brainrot)
    local stealing = false
    pcall(function()
        if LP:GetAttribute("Stealing") == true then stealing = true end
    end)
    pcall(function()
        if char:GetAttribute("Stealing") == true then stealing = true end
    end)
    if stealing then return true end

    -- dedicated API if present
    local ok = false
    pcall(function()
        if _G.AutoCarrySpeed and type(_G.AutoCarrySpeed.IsCarryingBrainrot) == "function" then
            if _G.AutoCarrySpeed.IsCarryingBrainrot(char) then ok = true end
        end
    end)
    if ok then return true end

    -- scan character for actual brainrot objects (not "carry" keyword alone)
    for _, obj in ipairs(char:GetDescendants()) do
        local n = string.lower(tostring(obj.Name or ""))
        if n:find("brainrot") or n:find("skibidi") then
            if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("Folder") then
                return true
            end
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" and obj.Name ~= "Head" then
                -- welded accessory-style part named brainrot
                if obj:IsDescendantOf(char) and obj.Parent ~= char then
                    return true
                end
            end
        end
    end
    return false
end

function _G.StealSpinV2.start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.stealSpinV2Enabled = true
    _G.StealSpinV2.enabled = true
    if _G.StealSpinV2.conn then pcall(function() _G.StealSpinV2.conn:Disconnect() end); _G.StealSpinV2.conn=nil end
    _G.StealSpinV2.wasOn = false
    _G.StealSpinV2.conn = RunService.Heartbeat:Connect(function()
        LPH_ATTRIBUTES(VM(NONE))
        if not _G.StealSpinV2.enabled then return end
        pcall(function()
            local holding = _moyaHoldingBrainrot()
            if holding then
                if not _G.spinBotV2Enabled then
                    pcall(function() _G.SpinBotV2.start() end)
                    pcall(function() if setVisual then setVisual("SpinBotV2", true) end end)
                    _G.StealSpinV2.wasOn = true
                end
            else
                -- only stop spin if WE turned it on for steal
                if _G.StealSpinV2.wasOn then
                    pcall(function() _G.SpinBotV2.stop() end)
                    pcall(function() if setVisual then setVisual("SpinBotV2", false) end end)
                    _G.StealSpinV2.wasOn = false
                end
            end
        end)
    end)
end

function _G.StealSpinV2.stop()
