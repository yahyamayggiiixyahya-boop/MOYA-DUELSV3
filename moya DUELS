-- Anti Back Lag V4: slow-walk mask for server (anti rubberband from fake-speed / high ping)
-- Idea: keep ownership + show the server a low horizontal speed so it does not hard-correct you backward.
_G.antiBackLagV4Enabled = false
_G.MoyaAntiBackLagV4 = _G.MoyaAntiBackLagV4 or {
    enabled = false,
    conn = nil,
    conn2 = nil,
    lastGood = nil,
    want = Vector3.new(0, 0, 1),
    lastWantT = 0,
    -- server-facing walk speed mask (studs/s) — very slow so server trusts soft movement
    maskSpeed = 9,
}

function _G.MoyaAntiBackLagV4Start()
    LPH_ATTRIBUTES(VM(NONE))
    _G.antiBackLagV4Enabled = true
    _G.MoyaAntiBackLagV4.enabled = true
    pcall(_G.MoyaAntiBackLagStart)
    local st = _G.MoyaAntiBackLagV4
    if st.conn then pcall(function() st.conn:Disconnect() end); st.conn = nil end
    if st.conn2 then pcall(function() st.conn2:Disconnect() end); st.conn2 = nil end
    st.lastGood = nil

    local function step(postPhys)
        LPH_ATTRIBUTES(VM(NONE))
        if not st.enabled then return end
        pcall(function()
            local char = player and player.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then return end

            pcall(function()
                if root.SetNetworkOwner then root:SetNetworkOwner(player) end
            end)

            local v = root.AssemblyLinearVelocity
            local md = hum.MoveDirection
            local flatV = Vector3.new(v.X, 0, v.Z)
            local mask = tonumber(st.maskSpeed) or 9

            local want = nil
            if md.Magnitude > 0.05 then
                want = md.Unit
                st.want = want
                st.lastWantT = tick()
            elseif flatV.Magnitude > 4 then
                want = flatV.Unit
                st.want = want
                st.lastWantT = tick()
            elseif tick() - (st.lastWantT or 0) < 0.4 then
                want = st.want
            end

            -- 1) Clamp insane velocities (anti-bat desync leftovers) so server never sees flash speed
            if flatV.Magnitude > 90 then
                local dir = flatV.Unit
                local soft = dir * math.min(flatV.Magnitude, 42)
                if want and soft:Dot(want) < 0 then
                    soft = want * mask
                end
                root.AssemblyLinearVelocity = Vector3.new(soft.X, math.clamp(v.Y, -50, 50), soft.Z)
                v = root.AssemblyLinearVelocity
                flatV = Vector3.new(v.X, 0, v.Z)
            end

            -- 2) Kill reverse component (rubberband) without hard teleport
            if want and flatV.Magnitude > 3 then
                local against = flatV:Dot(want)
                if against < -6 then
                    -- replace reverse with slow forward mask
                    root.AssemblyLinearVelocity = Vector3.new(want.X * mask, math.clamp(v.Y, -45, 45), want.Z * mask)
                    v = root.AssemblyLinearVelocity
                    flatV = Vector3.new(v.X, 0, v.Z)
                end
            end

            -- 3) Soft position hold: if server yanked us back a lot, ease forward a little (no full TP)
            local pos = root.Position
            local prev = st.lastGood
            if prev and want then
                local delta = pos - prev
                local flatD = Vector3.new(delta.X, 0, delta.Z)
                local back = flatD.Magnitude > 1.2 and flatD.Unit:Dot(want) < -0.25
                if back then
                    local fix = prev + want * 0.55
                    root.CFrame = root.CFrame:Lerp(CFrame.new(fix.X, pos.Y, fix.Z) * (root.CFrame - root.CFrame.Position), 0.35)
                    root.AssemblyLinearVelocity = Vector3.new(want.X * mask, math.clamp(v.Y, -40, 40), want.Z * mask)
                    if root.AssemblyAngularVelocity.Magnitude > 12 then
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end

            -- 4) Post-physics pass: optional slow mask pulse so replication samples look calm
            if postPhys and want and md.Magnitude > 0.05 then
                local cur = root.AssemblyLinearVelocity
                local f = Vector3.new(cur.X, 0, cur.Z)
                -- only mask when still very fast (keep playable feel)
                if f.Magnitude > 55 then
                    local blend = want * mask
                    root.AssemblyLinearVelocity = Vector3.new(
                        cur.X * 0.55 + blend.X * 0.45,
                        cur.Y,
                        cur.Z * 0.55 + blend.Z * 0.45
                    )
                end
            end

            -- track last good when not being yanked hard
            if want then
                if not prev then
                    st.lastGood = pos
                else
                    local d = pos - prev
                    local fd = Vector3.new(d.X, 0, d.Z)
                    if fd.Magnitude < 0.05 or fd.Unit:Dot(want) >= -0.1 then
                        st.lastGood = pos
                    end
                end
            else
                st.lastGood = pos
            end
        end)
    end

    local sig = RunService.PreSimulation or RunService.Stepped
    st.conn = sig:Connect(function() step(false) end)
    st.conn2 = RunService.Heartbeat:Connect(function() step(true) end)
end

